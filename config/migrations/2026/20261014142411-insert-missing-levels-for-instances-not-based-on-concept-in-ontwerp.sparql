PREFIX lpdcExt: <https://productencatalogus.data.vlaanderen.be/ns/ipdc-lpdc#>
PREFIX dct:     <http://purl.org/dc/terms/>
PREFIX mu:      <http://mu.semte.ch/vocabularies/core/>
PREFIX besluit: <http://data.vlaanderen.be/ns/besluit#>
PREFIX adms:    <http://www.w3.org/ns/adms#>

INSERT {
  GRAPH ?graph {
    ?instance lpdcExt:executingAuthorityLevel ?executingLevel .
    ?instance lpdcExt:competentAuthorityLevel ?competentLevel .
  }
}
WHERE {
  GRAPH ?graph {
    ?instance a lpdcExt:InstancePublicService ;
              adms:status <http://lblod.data.gift/concepts/instance-status/ontwerp> .
    FILTER NOT EXISTS { ?instance dct:source ?concept . }
  }
  FILTER(STRSTARTS(STR(?graph), "http://mu.semte.ch/graphs/organizations/"))

  OPTIONAL {
    GRAPH <http://mu.semte.ch/graphs/public> {
      ?province a besluit:Bestuurseenheid ;
                besluit:classificatie <http://data.vlaanderen.be/id/concept/BestuurseenheidClassificatieCode/5ab0e9b8a3b2ca7c5e000000> ;
                mu:uuid ?provinceUuid .
    }
    FILTER(STRSTARTS(STR(?graph), CONCAT("http://mu.semte.ch/graphs/organizations/", ?provinceUuid, "/")))
  }

  BIND(IF(BOUND(?province),
          <https://productencatalogus.data.vlaanderen.be/id/concept/UitvoerendBestuursniveau/Provinciaal>,
          <https://productencatalogus.data.vlaanderen.be/id/concept/UitvoerendBestuursniveau/Lokaal>)
       AS ?executingLevel)
  BIND(IF(BOUND(?province),
          <https://productencatalogus.data.vlaanderen.be/id/concept/BevoegdBestuursniveau/Provinciaal>,
          <https://productencatalogus.data.vlaanderen.be/id/concept/BevoegdBestuursniveau/Lokaal>)
       AS ?competentLevel)
}

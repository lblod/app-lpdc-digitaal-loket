PREFIX ext: <http://mu.semte.ch/vocabularies/ext/>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>

DELETE { 
  GRAPH <http://mu.semte.ch/graphs/lpdc/instancesnapshots-ldes-data/gent> { 
    ?marker ?mp ?mo 
} }
WHERE {
  {
    SELECT ?latest WHERE {
      GRAPH <http://mu.semte.ch/graphs/lpdc/instancesnapshots-ldes-data/gent> {
        ?latest dct:isVersionOf <http://data.lblod.info/id/public-service/1e067517-7c85-4438-94bc-7371e6c1d52f> ;
                prov:generatedAtTime ?generatedAtTime .
      }
    } ORDER BY DESC(?generatedAtTime) LIMIT 1
  }
  GRAPH <http://mu.semte.ch/graphs/lpdc/instancesnapshots-ldes-data/gent> { 
    ?marker ext:processedSnapshot ?latest ; ?mp ?mo . }
}
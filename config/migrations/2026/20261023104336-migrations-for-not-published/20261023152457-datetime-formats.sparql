PREFIX schema: <http://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

DELETE {
  GRAPH ?g { ?s schema:productID ?o . }
}
WHERE {
  GRAPH ?g { ?s schema:productID ?o . }
  FILTER(sameTerm(?o, STRDT(STR(?o), xsd:string)))
  FILTER(!STRSTARTS(STR(?g), "http://mu.semte.ch/graphs/lpdc/"))
}
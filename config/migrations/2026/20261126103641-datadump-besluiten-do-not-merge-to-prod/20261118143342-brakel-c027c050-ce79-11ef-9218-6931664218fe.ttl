<https://brakel-echo.cipalschaubroeck.be/id/besluiten/cc1b6fbb-657d-407b-aeac-951558ee15e2> a ns1:Besluit ;
    ns3:language <http://publications.europa.eu/resource/authority/language/NLD> ;
    ns3:passed_by <http://data.lblod.info/id/bestuursorganen/59b1dacf1caa0dd64b2a30cb8cea4c20ec24ea245289789b3dcb24ecb4e272c8> ;
    ns3:title "Samenwerkingsverbanden. IVLA. Uitnodiging Buitengewone Algemene Vergadering d.d. 06/02/2025. Goedkeuring." ;
    ns1:motivering """ 
                                                                 
                                                                    Regelgeving en bevoegdheid 
                                                                    Het Decreet Lokaal Bestuur van 22 december 2017, deel 3; 
                                                                    Het Raadsbesluit d.d. 06/01/2025 betreffende de aanstelling vertegenwoordiger en plaatsvervanger voor de algemene vergadering; 
                                                                 
                                                                 
                                                                    Feiten, context en argumentatie 
                                                                    De mail d.d. 10 december 2024 van IVLA omtrent de uitnodiging aan de gemeente Brakel tot deelname aan de Buitengewone Algemene Vergadering d.d. 06 februari 2024 om 18u00 bij IVLA, Meersbloem-Melden 46 A, 9700 Oudenaarde 
                                                                    Het Raadsbesluit d.d. 06/01/2025 betreffende de aanstelling vertegenwoordiger en plaatsvervanger voor de algemene vergadering; 
                                                                    De bijgevoegde agenda van voormelde vergadering zijnde: 
                                                                    1.   Aanstelling en benoeming van de bestuurders in toepassing van de Decreet Lokaal Bestuur (DLB) en de gecoördineerde statuten van IVLA. 
                                                                      
                                                                    Het College van Burgemeester en Schepenen d.d. 16 december 2024 nam kennis van deze uitnodiging. 
                                                                 
                                                            """@nl ;
    ns2:uuid "c027c050-ce79-11ef-9218-6931664218fe" ;
    prov:value """ 
                                                                 
                                                                    Besluit 
                                                                    Art. 1: De gemeenteraad neemt kennis van de uitnodiging van de Buitengewone Algemene Vergadering d.d. 06 februari 2025 van IVLA. 
                                                                    Art. 3: Afschrift van deze beslissing zal toegestuurd worden aan het secretariaat van IVLA - info@ivla.be. 
                                                                 
                                                            """ ;
    prov:wasGeneratedBy <https://brakel-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/cc1b6fbb-657d-407b-aeac-951558ee15e2> .


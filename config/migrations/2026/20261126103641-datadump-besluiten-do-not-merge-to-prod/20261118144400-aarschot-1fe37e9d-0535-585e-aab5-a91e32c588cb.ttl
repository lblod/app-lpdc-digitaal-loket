<https://aarschot-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/3f888ca2-e1ce-44b5-9255-31d01a3923e4> a ns2:BehandelingVanAgendapunt ;
    ns2:gebeurtNa <https://aarschot-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/19733601-075b-4155-8cd3-8e757a020c63> ;

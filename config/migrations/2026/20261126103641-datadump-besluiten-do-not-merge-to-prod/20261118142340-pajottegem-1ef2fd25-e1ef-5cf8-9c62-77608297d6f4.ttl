<https://pajottegem-echo.cipalschaubroeck.be/id/besluiten/15aed687-be35-426c-ac8a-1076795663a9> a ns1:Besluit,
        <https://data.vlaanderen.be/id/concept/BesluitType/256bd04a-b74b-4f2a-8f5d-14dda4765af9> ;
    ns2:description """ 
                                                    Het college keurt de politieverordening met tijdelijke verkeersmaatregelen voor de kaatstornooi op 15/08 goed. 
                                                """ ;
    ns2:language <http://publications.europa.eu/resource/authority/language/NLD> ;
    ns2:passed_by <http://data.lblod.info/id/bestuursorganen/1cd382ca-87a9-4693-8216-a4e5e16af3fa> ;
    ns2:title "Politieverordening: Herne Statie - 15/08" ;
    ns1:motivering """ 
                            """@nl ;
    ns3:uuid "1ef2fd25-e1ef-5cf8-9c62-77608297d6f4" ;
    prov:value """ 
                                 
                                    
                                        Artikel 1 - Ter gelegenheid van kaatstornooi op 15/08 worden volgende beperkingsmaatregelen voor het verkeer genomen vanaf 8u tot 22u:
                                     
                                    
                                         
                                     
                                     
                                         
                                            Verboden stil te staan en te parkeren (E3) wordt ingelast op de Spoorwegstraat ter hoogte van huisnummers 99 tot 113 en 68 tot 74 van 6.00 tot 22.00 uur 
                                         
                                          
                                         
                                            Verboden doorgang, in beide richtingen, voor iedere bestuurder (C3) uitgezonderd fietsers (M2): 
                                             
                                                in de Spoorwegstraat, langs de binnenzijde van het kruispunt met de Hernekouter tot aan huisnummer 62 
                                             
                                            Snelheidsverlaging naar 30 km/uur (C43), aankondiging 'lokale feesten': 
                                             
                                                Breemstraat op 300 meter van de overweg 
                                                Spoorwegstraat ter hoogte van het kruispunt met de Hernekouter 
                                                Lorengstraat, ter hoogte van de uitrit van de stationsparking 
                                                Lorengstraat, ter hoogte van het kruispunt met Scherpstraat 
                                             
                                            Verboden doorgang, in beide richtingen, voor iedere bestuurder (C3), uitgezonderd plaatselijk verkeer (type IV), doodlopende weg (F45): 
                                             
                                                Spoorwegstraat, ter hoogte van het kruispunt met de Scherpstraat 
                                                Spoorwegstraat, ter hoogte van het kruispunt met de Hernekouter 
                                             
                                            Omleiding (F41) naar het station: 
                                             
                                                op ieder kruispunt op de omleidingsroute Spoorwegstraat, Scherpstraat en Lorengstraat 
                                             
                                            Verboden voor verkeer +3,5 t (C21): 
                                             
                                                Breemstraat, ter hoogte van het kruispunt met de Geraardsbergsesteenweg 
                                             
                                            Verboden linksaf te slaan (C31A) voor verkeer +3,5 ton (type IV), uitgezonderd plaatselijk verkeer (type IV): 
                                             
                                                Geraardsbergsesteenweg, ter hoogte van het kruispunt met de Breemstraat 
                                             
                                            Vooraankondiging 'N269 onderbroken / station bereikbaar via omleiding / Geraardsbergen via N255-N495': 
                                             
                                                Spoorwegstraat,  ter hoogte van het kruispunt met Centrum (zichtbaar van op Centrum) 
                                                Oude STeenweg, ter hoogte van het kruispunt met de Spoorwegstraat (zichtbaar van op Oude Steenweg) 
                                             
                                          
                                     
                                    
                                         
                                     
                                     
                                         
                                            Artikel 2 - De signalisatie zal worden aangeleverd door de gemeentediensten overeenkomstig de wettelijke voorschriften. 
                                         
                                        Artikel 3 - Te voorzien door de organisatoren: 
                                         
                                             De bewoners langsheen de straten waar er verkeersmaatregelen worden ingevoerd, moeten minstens 48 uur op voorhand schriftelijk op de hoogte worden gebracht van het evenement en van de verkeersmaatregelen.  
                                             Alle tijdelijk voorziene verkeersborden en hekkens dienen door de organisatoren overeenkomstig de wettelijke voorschriften voor het evenement geplaatst en onmiddellijk na het evenement te worden verwijderd of afgedekt.  
                                         
                                     
                                 
                            """ ;
    prov:wasGeneratedBy <https://pajottegem-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/15aed687-be35-426c-ac8a-1076795663a9> .


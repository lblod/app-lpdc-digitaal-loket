    ns2:title "Gemeenteraad. Commissie financiën en sociale zaken. Oprichting en samenstelling." ;
    ns1:motivering """ 
                                                                 
                                                                    Regelgeving en bevoegdheid 
                                                                    Decreet Lokaal Bestuur, artikel 37 
                                                                    Het huishoudelijk reglement van de gemeenteraad Brakel, artikel 28 
                                                                    Het college van burgemeester en schepenen stelt voor een commissie grondgebiedszaken, mobiliteit en omgeving op te richten. 
                                                                 
                                                                 
                                                                    Feiten, context en argumentatie 
                                                                    Bij toepassing van de berekeningswijze overeenkomstig artikel 28, §2 wordt een raadscommissie van 13 leden samengesteld uit: 
                                                                    
                                                                         
                                                                             
                                                                             
                                                                             
                                                                             
                                                                             
                                                                             
                                                                         
                                                                         
                                                                             
                                                                                Lijsten 
                                                                                Gemeenteraadszetels 
                                                                                Formule 
                                                                                Rechtstreek verkozen 
                                                                                Restsaldo 
                                                                                Totaal aantal zetels 
                                                                             
                                                                             
                                                                                  
                                                                                  
                                                                                13/25 * zetels 
                                                                                  
                                                                                Ifv grootste resterende breuk 
                                                                                  
                                                                             
                                                                             
                                                                                Open Vld (3556) 
                                                                                13 
                                                                                169 
                                                                                6 (150(4*25)) 
                                                                                1(19/25) 
                                                                                7 
                                                                             
                                                                             
                                                                                Broakel 2,0 (1976) 
                                                                                6 
                                                                                78 
                                                                                3 (75(3*25) 
                                                                                3 
                                                                                3 
                                                                             
                                                                             
                                                                                Vooruit (625) 
                                                                                1 
                                                                                13 
                                                                                0 
                                                                                13 
                                                                                0 
                                                                             
                                                                             
                                                                                Vlaamse Belang (1441) 
                                                                                4 
                                                                                52 
                                                                                2 (50(2*25) 
                                                                                2 
                                                                                2 
                                                                             
                                                                             
                                                                                Groen (642) 
                                                                                1 
                                                                                13 
                                                                                0 
                                                                                1(13/25) grootste stemcijfer 
                                                                                1 
                                                                             
                                                                             
                                                                                Totaal aantal zetels 
                                                                                25 
                                                                                  
                                                                                11 
                                                                                2 
                                                                                13 
                                                                             
                                                                         
                                                                     
                                                                      
                                                                    Als een fractie niet vertegenwoordigd is (in casu Vooruit), kan de fractie een lid met raadgevende stem aanduiden. Dit geeft ook recht op eenzelfde presentiegeld als voor de andere leden. 
                                                                 
                                                            """@nl ;

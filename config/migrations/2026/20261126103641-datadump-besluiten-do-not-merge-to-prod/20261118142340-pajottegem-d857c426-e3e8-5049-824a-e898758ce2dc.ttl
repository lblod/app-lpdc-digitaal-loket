<https://pajottegem-echo.cipalschaubroeck.be/id/besluiten/7928caa8-0ecc-4beb-86ba-9e1ed594b223> a ns2:Besluit,
        <https://data.vlaanderen.be/id/concept/BesluitType/256bd04a-b74b-4f2a-8f5d-14dda4765af9> ;
    ns3:description """ 
                                                    Het college keurt de politieverordening met tijdelijke verkeersmaatregelen voor de Processie Kester op 15 juni 2025 goed. 
                                                """ ;
    ns3:language <http://publications.europa.eu/resource/authority/language/NLD> ;
    ns3:passed_by <http://data.lblod.info/id/bestuursorganen/1cd382ca-87a9-4693-8216-a4e5e16af3fa> ;
    ns3:title "Politieverordening: Processie Kester - 15 juni 2025 " ;
    ns2:motivering """ 
                            """@nl ;
    ns1:uuid "d857c426-e3e8-5049-824a-e898758ce2dc" ;
    prov:value """ 
                                 
                                    
                                        Artikel 1 - Ter gelegenheid van Processie Kester op 15 juni 2025 worden volgende beperkingsmaatregelen voor het verkeer genomen:
                                     
                                    
                                         
                                     
                                     
                                         
                                            
                                                Stilstaan en parkeren verboden (E3) vanaf 6u30 tot 9u op:
                                             
                                            
                                                de Sint-Niklaasstraat langsbeide zijden van de weg tussen huisnummers 11A en 47.
                                             
                                            
                                                 
                                             
                                         
                                        
                                            Stilstaan en parkeren verboden (E3) vanaf 8u30 tot 10u op:
                                         
                                        
                                            het Kerkplein van Oetingen
                                         
                                        
                                             
                                         
                                        
                                            Stilstaan en parkeren verboden (E3) vanaf 6u tot 15u op:
                                         
                                        
                                            de Edingsesteenweg, vanaf het kruispunt met de Bruneaustraat tot het kruispunt met de Kesterweg – beide richtingen
                                            de Kesterweg, vanaf het kruispunt met de Edingsesteenweg tot het kruispunt met de Bruneaustraat – beide richtingen
                                            de Bruneaustraat, vanaf het kruispunt met de Edingsesteenweg tot het kruispunt met de Oude Molenstraat – beide richtingen
                                         
                                        
                                            de Bruneaustraat langs huisnr. 74-80A (rechterzijde plein voor kerk)
                                         
                                        
                                            de Lenniksestraat tussen huisns 81 en 87
                                         
                                        
                                            
                                         
                                        
                                             
                                            
                                                Stilstaan en parkeren verboden (E3) vanaf zaterdag 14 juni 2025 tot zondag 16 juni 2025 op:
                                             
                                         
                                        
                                            op parking Bergsken Op begin Patattestraat t.h.v. huisnr. 2-4
                                         
                                        
                                            
                                         
                                         
                                            Verplicht parkeren op het voetpad (fig E9a) op 15 juni 2025 van 6u tot 15u wordt ingelast in volgende straten: 
                                            Oude Molenstraat (N272) tussen beide zijstraten Raoul Merckxstraat langs zijde pare huisnummers. 
                                         
                                        
                                             
                                         
                                        
                                            Verboden toegang, in beide richtingen, voor ieder bestuurder (C3) vanaf 6u tot 15u in:
                                         
                                        
                                            Bruneaustraat vanaf het kruispunt met de Kesterweg tot het kruispunt met de Patattestraat.
                                         
                                        
                                             
                                         
                                        
                                            Eénrichtingsverkeer (fig C1 + fig F19) wordt ingelast van 10.00 uur tot 12.00 uur in volgende straten:
                                         
                                         
                                            - Kesterweg 
                                            Verboden richting voor ieder bestuurder (fig C1) op de Kesterweg vanaf het kruispunt met de Edingsesteenweg (N285) tot het kruispunt met de Vierbergenstraat. 
                                            Snelheidsverlaging (fig C43) naar 50 km/u op de Edingsesteenweg tussen de Bruneaustraat (N272) en de Bruneaustraat. 
                                            Snelheidsverlaging (fig C43) naar 30 km/u op de Edingsesteenweg tussen de Bruneaustraat en Kesterweg. 
                                              
                                         
                                     
                                     
                                         
                                            Artikel 2 - De signalisatie zal worden aangeleverd door de gemeentediensten volgens het voorstel van de lokale politiezone Pajottenland, overeenkomstig de wettelijke voorschriften. 
                                         
                                        Artikel 3 - Te voorzien door de organisatoren: 
                                         
                                             De bewoners langsheen de straten waar er verkeersmaatregelen worden ingevoerd, moeten minstens 48 uur op voorhand schriftelijk op de hoogte worden gebracht van het evenement en van de verkeersmaatregelen.  
                                             Alle tijdelijk voorziene verkeersborden en hekkens dienen door de organisatoren volgens het voorstel van de Lokale Politiezone Pajottenland, overeenkomstig de wettelijke voorschriften voor het evenement geplaatst en onmiddellijk na het evenement te worden verwijderd of afgedekt.  
                                         
                                     
                                 
                            """ ;
    prov:wasGeneratedBy <https://pajottegem-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/7928caa8-0ecc-4beb-86ba-9e1ed594b223> .


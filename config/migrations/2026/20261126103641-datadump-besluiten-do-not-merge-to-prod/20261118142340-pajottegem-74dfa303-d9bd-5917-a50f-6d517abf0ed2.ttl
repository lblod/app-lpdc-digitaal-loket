<https://pajottegem-echo.cipalschaubroeck.be/id/besluiten/3cfd8065-9b6c-410d-b7b2-72a8e05f77e5> a ns3:Besluit,
        <https://data.vlaanderen.be/id/concept/BesluitType/256bd04a-b74b-4f2a-8f5d-14dda4765af9> ;
    ns1:description """ 
                                                    Het college keurt de politieverordening met tijdelijke verkeersmaatregelen voor een buurtfeest op 27 juni van 17u tot 28 juni 2026 om 3u goed. 
                                                """ ;
    ns1:language <http://publications.europa.eu/resource/authority/language/NLD> ;
    ns1:passed_by <http://data.lblod.info/id/bestuursorganen/1cd382ca-87a9-4693-8216-a4e5e16af3fa> ;
    ns1:title "Politieverordening: buurtfeest: Havifeesten te Havilandstraat, Leerbeek - 27 juni van 17u tot 28 juni 2026 om 3u" ;
    ns3:motivering """ 
                            """@nl ;
    ns2:uuid "74dfa303-d9bd-5917-a50f-6d517abf0ed2" ;
    prov:value """ 
                                 
                                    
                                        Artikel 1 - Ter gelegenheid van buurtfeest op 27 juni en 28 juni 2026  worden volgende beperkingsmaatregelen voor het verkeer genomen van 12u t.e.m. 9u:
                                     
                                    
                                         
                                     
                                    
                                         
                                     
                                     
                                         
                                            Verboden toegang voor iedere bestuurder, in beide richtingen (Fig. C3) op Havilandstraat, tussen kruispunt met Winnepenninckxstraat en kruispunt met Tramstraat. 
                                         
                                     
                                    
                                         
                                     
                                    
                                         
                                     
                                    
                                         
                                     
                                     
                                         
                                            Artikel 2 - De signalisatie zal worden aangeleverd door de gemeentediensten overeenkomstig de wettelijke voorschriften. 
                                         
                                        Artikel 3 - Te voorzien door de organisatoren: 
                                         
                                             De bewoners langsheen de straten waar er verkeersmaatregelen worden ingevoerd, moeten minstens 48 uur op voorhand schriftelijk op de hoogte worden gebracht van het evenement en van de verkeersmaatregelen.  
                                             Alle tijdelijk voorziene verkeersborden en hekkens dienen door de organisatoren overeenkomstig de wettelijke voorschriften voor het evenement geplaatst en onmiddellijk na het evenement te worden verwijderd of afgedekt.  
                                         
                                     
                                 
                            """ ;
    prov:wasGeneratedBy <https://pajottegem-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/3cfd8065-9b6c-410d-b7b2-72a8e05f77e5> .


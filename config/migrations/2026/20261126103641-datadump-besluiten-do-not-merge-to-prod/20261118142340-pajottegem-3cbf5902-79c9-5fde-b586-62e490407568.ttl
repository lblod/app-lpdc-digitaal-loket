<https://pajottegem-echo.cipalschaubroeck.be/id/besluiten/c2782825-e30c-4a2a-89f6-8e5623c56008> a ns2:Besluit,
        <https://data.vlaanderen.be/id/concept/BesluitType/256bd04a-b74b-4f2a-8f5d-14dda4765af9> ;
    ns1:description """ 
                                                    Het college keurt de politieverordening met tijdelijke verkeersmaatregelen voor de Wielerwedstrijd op 31 mei 2026 goed. 
                                                """ ;
    ns1:language <http://publications.europa.eu/resource/authority/language/NLD> ;
    ns1:passed_by <http://data.lblod.info/id/bestuursorganen/1cd382ca-87a9-4693-8216-a4e5e16af3fa> ;
    ns1:title "Politieverordening: Wielerwedstrijd Omloop Nieuwsblad U23 - 31 mei 2026" ;
    ns2:motivering """ 
                            """@nl ;
    ns3:uuid "3cbf5902-79c9-5fde-b586-62e490407568" ;
    prov:value """ 
                                 
                                    
                                        Artikel 1 - Ter gelegenheid van wielerwedstrijd op 31 mei 2026 worden volgende beperkingsmaatregelen voor het verkeer genomen:
                                     
                                    
                                         
                                     
                                    
                                         
                                     
                                    
                                        Stilstaan- en parkeerverbod (fig E3) wordt ingelast van 30-05-2026 12.00 uur tot 31-05-2026 16.30 uur in volgende straat:
                                     
                                     
                                         
                                            Heirbaan 
                                         
                                     
                                     
                                        Stilstaan en parkeren verboden (fig E3) op de Heirbaan vanaf de Kapellestraat (grondgebied Geraardsbergen) tot het kruispunt met de Bruinsbroekstraat. 
                                        Stilstaan- en parkeerverbod (fig E3) wordt ingelast op 31-05-2026 van 12.00 uur tot 18.00 uur in volgende straten: 
                                         
                                            Heirbaan 
                                         
                                        Stilstaan en parkeren verboden (fig E3) op de Heirbaan vanaf de Bruinsbroekstraat tot de Meidries (grondgebied Geraardsbergen). 
                                         
                                            Bruinsbroekstraat 
                                         
                                        Stilstaan en parkeren verboden (fig E3) op de Bruinsbroekstraat vanaf het kruispunt met de Waterschaapstraat tot het kruispunt met de Heirbaan. 
                                          
                                        Eénrichtingsverkeer (fig C1 + fig F19) wordt ingelast op 01-06-2025 van 14.30 uur tot 16.00 uur in volgende straten: 
                                         
                                            Bruinsbroekstraat 
                                         
                                        Verboden richting voor ieder bestuurder (fig C1) op de Bruinsbroekstraat vanaf het kruispunt met de Waterschaapstraat (verkeersbord + nadar!) tot het kruispunt met de Heirbaan. 
                                          
                                        Verbod aan het volgend kruispunt af te slaan in de richting door de pijl aangegeven (fig C31a / fig C31b) wordt ingelast op 01-06-2025 van 14.30 uur tot 16.00 uur op volgende kruispunten: 
                                         
                                            Bruinsbroekstraat 
                                         
                                        Noremansberg / BruinsbroekstraatWaterschaapstraat / Bruinbroekstraat 
                                          
                                        NadarsNadars op de Heirbaan vanaf de top van de Bosberg (kruispunt Noremansberg inbegrepen) tot het kruispunt met de Bruinsbroekstraat. Deze dienen geplaatst te worden op de dag van de wedstrijd voor 12.00 uur, de nodige afspraken in verband met de plaatsing dienen gemaakt te worden tussen de organisator en de gemeente Pajottegem. Indien deze nadars niet geplaatst worden is het onmogelijk om de supporters van de rijbaan te houden en een veilige doortocht te garanderen! 
                                     
                                    
                                         
                                     
                                    
                                         
                                     
                                    
                                         
                                     
                                     
                                         
                                            Artikel 2 - De signalisatie zal worden aangeleverd door de gemeentediensten volgens het voorstel van de lokale politiezone Pajottenland, overeenkomstig de wettelijke voorschriften. 
                                             
                                             
                                         
                                        Artikel 3 - Te voorzien door de organisatoren: 
                                         
                                             De bewoners langsheen de straten waar er verkeersmaatregelen worden ingevoerd, moeten minstens 48 uur op voorhand schriftelijk op de hoogte worden gebracht van het evenement en van de verkeersmaatregelen.  
                                             Alle tijdelijk voorziene verkeersborden en hekkens dienen door de organisatoren volgens het voorstel van de Lokale Politiezone Pajottenland, overeenkomstig de wettelijke voorschriften voor het evenement geplaatst en onmiddellijk na het evenement te worden verwijderd of afgedekt.  
                                         
                                     
                                 
                            """ ;
    prov:wasGeneratedBy <https://pajottegem-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/c2782825-e30c-4a2a-89f6-8e5623c56008> .


<https://pajottegem-echo.cipalschaubroeck.be/id/besluiten/a5d6cfba-79b5-4ad2-b95a-2bd70924d289> a ns1:Besluit,
        <https://data.vlaanderen.be/id/concept/BesluitType/256bd04a-b74b-4f2a-8f5d-14dda4765af9> ;
    ns3:description """ 
                                                    Het college keurt de politieverordening met tijdelijke verkeersmaatregelen voor de buurtfeest op 25 mei 2025 goed. 
                                                """ ;
    ns3:language <http://publications.europa.eu/resource/authority/language/NLD> ;
    ns3:passed_by <http://data.lblod.info/id/bestuursorganen/1cd382ca-87a9-4693-8216-a4e5e16af3fa> ;
    ns3:title "Politieverordening: Buurtfeest WaKa Warandestraat - 25 mei 2025" ;
    ns1:motivering """ 
                            """@nl ;
    ns2:uuid "4cad39a8-401b-5e75-8786-aed46daca305" ;
    prov:value """ 
                                 
                                    
                                        Artikel 1 - Ter gelegenheid van buurtfeest op 25 mei 2025 worden volgende beperkingsmaatregelen voor het verkeer genomen vanaf 11u t.e.m. 21u:
                                     
                                    
                                         
                                     
                                    
                                         
                                     
                                    
                                        Afsluiten van de rijweg op 25 mei 2025 tussen 7u en 23u (nadar + C3):
                                     
                                    
                                         
                                     
                                    
                                        Warandestraat tussen Kerkstraat en Condijstraat
                                     
                                    
                                         
                                     
                                     
                                         
                                            Artikel 2 - De signalisatie zal worden aangeleverd door de gemeentediensten de wettelijke voorschriften. 
                                         
                                        Artikel 3 - Te voorzien door de organisatoren: 
                                         
                                             De bewoners langsheen de straten waar er verkeersmaatregelen worden ingevoerd, moeten minstens 48 uur op voorhand schriftelijk op de hoogte worden gebracht van het evenement en van de verkeersmaatregelen.  
                                             Alle tijdelijk voorziene verkeersborden en hekkens dienen door de organisatoren overeenkomstig de wettelijke voorschriften voor het evenement geplaatst en onmiddellijk na het evenement te worden verwijderd of afgedekt.  
                                         
                                     
                                 
                            """ ;
    prov:wasGeneratedBy <https://pajottegem-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/a5d6cfba-79b5-4ad2-b95a-2bd70924d289> .


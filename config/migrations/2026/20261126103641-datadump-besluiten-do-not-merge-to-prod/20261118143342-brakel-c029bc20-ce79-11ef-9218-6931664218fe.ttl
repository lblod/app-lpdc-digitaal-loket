<https://brakel-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/325c2f66-67e1-43b5-85c2-088d4e50e68c> a ns1:BehandelingVanAgendapunt ;
    ns1:gebeurtNa <https://brakel-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/cc1b6fbb-657d-407b-aeac-951558ee15e2> ;
    ns1:openbaar true ;
    ns3:uuid "7c5b1dd1-e840-5ede-8706-102b887b0cf8" ;
    dcterms:description """ 
                                                             
                                                                Per e-mail en aangetekend schrijven d.d. 09 december 2024 werd de gemeente Brakel opgeroepen om deel te nemen aan de Buitengewone Algemene Vergadering van Farys ov die plaats heeft op 28 maart 2025. 
                                                             
                                                        """ ;
    dcterms:subject <https://brakel-echo.cipalschaubroeck.be/id/agendapunten/325c2f66-67e1-43b5-85c2-088d4e50e68c> ;
    prov:generated <https://brakel-echo.cipalschaubroeck.be/id/besluiten/325c2f66-67e1-43b5-85c2-088d4e50e68c> .

<https://brakel-echo.cipalschaubroeck.be/id/besluiten/325c2f66-67e1-43b5-85c2-088d4e50e68c> a ns1:Besluit,
        <https://data.vlaanderen.be/id/concept/BesluitType/e96ec8af-6480-4b32-876a-fefe5f0a3793> ;
    ns2:language <http://publications.europa.eu/resource/authority/language/NLD> ;
    ns2:passed_by <http://data.lblod.info/id/bestuursorganen/59b1dacf1caa0dd64b2a30cb8cea4c20ec24ea245289789b3dcb24ecb4e272c8> ;
    ns2:title "Samenwerkingsverbanden. FARYS ov. Uitnodiging Buitengewone Algemene Vergadering d.d. 28 maart 2025. Goedkeuring." ;
    ns1:motivering """ 
                                                                 
                                                                    Regelgeving en bevoegdheid 
                                                                    Het Decreet Lokaal Bestuur van 22 december 2017; 
                                                                    Het raadsbesluit d.d. 06 januari 2025 omtrent de aanduiding van 2 vertegenwoordigers en 1 plaatsvervanger voor de Algemene Vergaderingen van Farys ov; 
                                                                 
                                                                 
                                                                    Feiten, context en argumentatie 
                                                                    Het feit dat de gemeente Brakel aangesloten is bij Farys ov; 
                                                                    De statuten van Farys ov; 
                                                                    Gelet op de oproepingsbrief voor de Buitengewone Algemene Vergadering van Farys ov op 28 maart 2025, waarin de agenda werd meegedeeld; 
                                                                    Gelet de bepalingen van het Decreet over het Lokaal Bestuur; 
                                                                    Het College van Burgemeester en Schepen d.d. 16 december 2024 nam kennis van de agenda én alle bijhorende stukken. Het college stelde voor om deze agenda met bijhorende stukken goed te keuren. 
                                                                 
                                                            """@nl ;
    ns3:uuid "c029bc20-ce79-11ef-9218-6931664218fe" ;
    prov:value """ 
                                                                 
                                                                    Besluit 
                                                                    Artikel 1.  
                                                                    De gemeenteraad beslist goedkeuring te verlenen aan alle punten op de agenda van de Buitengewone Algemene Vergadering Farys ov van 28 maart 2025 en de daarbij behorende documentatie nodig voor het onderzoek van de agendapunten: 
                                                                    1. Wijzigingen in deelnemers en/of kapitaal 
                                                                    2. Stand van zaken van bijlage 1 en 2 aan de statuten ingevolge wijzigingen in deelnemers en/of kapitaal 
                                                                    3. Ontslag en benoeming van de bestuurders in de Raad van Bestuur 
                                                                    4. Ontslag en benoeming van de leden van de adviescomités 
                                                                    Varia. 
                                                                      
                                                                    Artikel 2.  
                                                                    De gemeenteraad draagt de aangeduide vertegenwoordiger(s)/plaatsvervanger op om namens het bestuur alle akten en bescheiden met betrekking tot de Buitengewone Algemene Vergadering van Farys ov vastgesteld op 28 maart 2025, te onderschrijven en haar/zijn (hun) stemgedrag af te stemmen op het in de beslissing van de (gemeente)raad van heden bepaalde standpunt met betrekking tot de agendapunten van voormelde Buitengewone Algemene Vergadering. 
                                                                      
                                                                    Artikel 3. Een afschrift van dit besluit zal worden verstuurd: 
                                                                    • hetzij per elektronische post, 20250328BAV@farys.be, 
                                                                    • hetzij per post t.a.v. Farys ov, dienst Intercommunaal Beheer, Stropstraat 1 te 9000 Gent, gestuurd worden. 
                                                                 
                                                            """ ;
    prov:wasGeneratedBy <https://brakel-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/325c2f66-67e1-43b5-85c2-088d4e50e68c> .


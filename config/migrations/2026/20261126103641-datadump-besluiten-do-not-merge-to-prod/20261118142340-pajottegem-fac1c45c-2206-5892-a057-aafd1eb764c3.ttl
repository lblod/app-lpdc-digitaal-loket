<https://pajottegem-echo.cipalschaubroeck.be/id/besluiten/432d4372-7150-45cf-a0e1-36a3805adb3b> a ns1:Besluit,
        <https://data.vlaanderen.be/id/concept/BesluitType/256bd04a-b74b-4f2a-8f5d-14dda4765af9> ;
    ns3:description """ 
                                                    Het college keurt de politieverordening met tijdelijke verkeersmaatregelen voor de Meikermis Oetingen van 29 mei tot 1 juni 2025 goed. 
                                                """ ;
    ns3:language <http://publications.europa.eu/resource/authority/language/NLD> ;
    ns3:passed_by <http://data.lblod.info/id/bestuursorganen/1cd382ca-87a9-4693-8216-a4e5e16af3fa> ;
    ns3:title "Politieverordening: Meikermis Oetingen - Van 29 mei tot 1 juni 2025" ;
    ns1:motivering """ 
                            """@nl ;
    ns2:uuid "fac1c45c-2206-5892-a057-aafd1eb764c3" ;
    prov:value """ 
                                 
                                    
                                        Artikel 1 - Ter gelegenheid van Meikermis Oetingen voor opstellen, verblijven en afbreken kermis wagens van 27 mei tot 4 juni 2025 worden volgende beperkingsmaatregelen voor het verkeer genomen:
                                     
                                    
                                         
                                     
                                    
                                        Op het volledige Kerkplein geldt:
                                     
                                    
                                         
                                     
                                    
                                        het stilstaan en parkeren is verboden;
                                        het begin van de parkeerreglementering wordt aangeduid;
                                        Dit wordt gesignaleerd door:
                                        - verkeersborden E3
                                        - de verkeersborden worden aangevuld met x-borden Xa
                                     
                                    
                                         
                                     
                                    
                                        Op het Kerkplein geldt:
                                     
                                    
                                        de toegang is verboden in beide richtingen, voor iedere bestuurder, uitgezonderd plaatselijk verkeer.
                                        Dit wordt gesignaleerd door:
                                        - verkeersborden C3
                                     
                                    
                                        - onderbord type IV
                                     
                                     
                                        Artikel 2 - De signalisatie zal worden aangeleverd door de gemeentediensten volgens het voorstel van de lokale politiezone Pajottenland, overeenkomstig de wettelijke voorschriften. 
                                     
                                     
                                        Artikel 3 - Te voorzien door de organisatoren: 
                                         
                                             De bewoners langsheen de straten waar er verkeersmaatregelen worden ingevoerd, moeten minstens 48 uur op voorhand schriftelijk op de hoogte worden gebracht van het evenement en van de verkeersmaatregelen.  
                                             Alle tijdelijk voorziene verkeersborden en hekkens dienen door de organisatoren volgens het voorstel van de Lokale Politiezone Pajottenland, overeenkomstig de wettelijke voorschriften voor het evenement geplaatst en onmiddellijk na het evenement te worden verwijderd of afgedekt.  
                                         
                                     
                                 
                            """ ;
    prov:wasGeneratedBy <https://pajottegem-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/432d4372-7150-45cf-a0e1-36a3805adb3b> .


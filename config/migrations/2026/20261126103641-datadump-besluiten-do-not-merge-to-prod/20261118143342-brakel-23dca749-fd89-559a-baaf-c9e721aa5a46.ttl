<https://brakel-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/01a8f876-04d7-4a33-94dd-cd47f6e730d2> a ns1:BehandelingVanAgendapunt ;
    ns1:gebeurtNa <https://brakel-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/22d80fbe-4d9c-4c20-a2e5-b6baeea70a2a> ;

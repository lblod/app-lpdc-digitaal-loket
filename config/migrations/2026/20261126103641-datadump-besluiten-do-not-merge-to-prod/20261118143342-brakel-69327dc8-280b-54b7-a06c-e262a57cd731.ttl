    ns2:uuid "ccb1bb02-c4f0-5ccb-9e92-81138aeec058" ;
    dcterms:description """ 
                                                             
                                                                De aangetekend brief d.d. 12 mei 2025 vanwege de Woonmaatschappij Vlaamse Ardennen waarbij de gemeente Brakel wordt uitgenodigd tot deelname aan de jaarlijkse Algemene Vergadering van 03 juni 2025 om 19u00 te 9700 Oudenaarde, Ladeuze 5. 
                                                             
                                                        """ ;
    dcterms:subject <https://brakel-echo.cipalschaubroeck.be/id/agendapunten/051dca70-fc5a-4c63-a142-f7ca0a358a6f> ;
    prov:generated <https://brakel-echo.cipalschaubroeck.be/id/besluiten/051dca70-fc5a-4c63-a142-f7ca0a358a6f> .

<https://brakel-echo.cipalschaubroeck.be/id/besluiten/051dca70-fc5a-4c63-a142-f7ca0a358a6f> a ns1:Besluit,
        <https://data.vlaanderen.be/id/concept/BesluitType/e96ec8af-6480-4b32-876a-fefe5f0a3793> ;
    ns3:language <http://publications.europa.eu/resource/authority/language/NLD> ;
    ns3:passed_by <http://data.lblod.info/id/bestuursorganen/59b1dacf1caa0dd64b2a30cb8cea4c20ec24ea245289789b3dcb24ecb4e272c8> ;
    ns3:title "Samenwerkingsverbanden. Woonmaatschappij Vlaamse Ardennen. Uitnodiging Algemene Vergadering d.d. 3 juni 2025. Goedkeuring." ;
    ns1:motivering """ 
                                                                 
                                                                    Regelgeving en bevoegdheid 
                                                                    Het Decreet Lokaal Bestuur van 22 december 2017; 
                                                                    Het raadbesluit d.d. 03 maart 2025 omtrent de aanduiding van een vertegenwoordiger voor de algemene vergadering voor de volledige legislatuur; 
                                                                 
                                                                 
                                                                    Feiten, context en argumentatie 
                                                                    - De uitnodiging voor de jaarlijkse Algemene Vergadering der aandeelhouders van Woonmaatschappij Vlaamse Ardennen met maatschappelijke zetel te 9700 Oudenaarde, Sint-Jozefsplein 18, die zal gehouden worden op dinsdag 03 juni 2025 om 19u00 in Ladeuze, Ladeuze 5 te 9680 Maarkedal. 
                                                                    Het aangetekend schrijven d.d. 12 mei 2025 van de Woonmaatschappij Vlaamse Ardennen met de volgende dagorde: 
                                                                    1. Jaarverslag van de Raad van Bestuur en Commissaris; 
                                                                    2. Goedkeuring jaarrekening 
                                                                    3. Winstbestemming 
                                                                    4. Kwijting bestuurders en commissaris 
                                                                    5. Varia 
                                                                      
                                                                    - De gemeenteraadsbeslissing d.d. 07 april 2025 waarbij de vertegenwoordigers werden aangeduid om de gemeente Brakel te vertegenwoordigen in de Algemene vergaderingen van Woonmaatschappij Vlaamse Ardennen 
                                                                    - Het College van Burgemeester en Schepenen d.d. 19 mei 2025 nam kennis van de uitnodiging en de agenda van de Woonmaatschappij Vlaamse Ardennen d.d.03 juni 2025. 
                                                                 
                                                            """@nl ;
    ns2:uuid "69327dc8-280b-54b7-a06c-e262a57cd731" ;
    prov:value """ 
                                                                 
                                                                    Besluit 
                                                                    Art. 1: De agenda van de jaarlijkse Algemene Vergadering der aandeelhouders van Woonmaatschappij Vlaamse Ardennen d.d. 03 juni 2025 wordt goedgekeurd. 
                                                                    Art. 2: De vertegenwoordiger van de gemeente die zal deelnemen aan de jaarlijkse Algemene Vergadering wordt opgedragen het stemgedrag af te stemmen op de beslissing genomen zoals in artikel 1 van dit besluit.  
                                                                    Art. 3: Afschrift van deze beslissing en het inschrijvingsformulier zal toegestuurd worden aan Woonmaatschappij Vlaamse Ardennen aan nathalie.verhaeghe@wmvla.be 
                                                                 
                                                            """ ;
    prov:wasGeneratedBy <https://brakel-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/051dca70-fc5a-4c63-a142-f7ca0a358a6f> .


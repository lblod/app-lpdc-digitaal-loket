<https://brakel-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/051dca70-fc5a-4c63-a142-f7ca0a358a6f> a ns1:BehandelingVanAgendapunt ;
    ns1:gebeurtNa <https://brakel-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/8ed10e0c-075c-4a1e-b61e-6a498c0c4acf> ;

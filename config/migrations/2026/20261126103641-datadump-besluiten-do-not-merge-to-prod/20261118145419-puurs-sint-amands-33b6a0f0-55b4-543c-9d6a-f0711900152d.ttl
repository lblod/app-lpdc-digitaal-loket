<https://puurs-sint-amands-echo.cipalschaubroeck.be/id/besluiten/fd53e791-8151-4a0b-b373-ac427ece79f2> a ns2:Besluit,
        <https://data.vlaanderen.be/id/concept/BesluitType/4d8f678a-6fa4-4d5f-a2a1-80974e43bf34> ;

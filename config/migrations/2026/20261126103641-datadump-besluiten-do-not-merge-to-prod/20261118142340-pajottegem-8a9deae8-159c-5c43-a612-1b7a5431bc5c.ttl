    ns2:description """ 
                                                    De opdracht “Onderhoud begraafplaatsen Herne” wordt gegund aan de economisch meest voordelige regelmatige bieder. 
                                                """ ;
    ns2:language <http://publications.europa.eu/resource/authority/language/NLD> ;

<https://pajottegem-echo.cipalschaubroeck.be/id/besluiten/6e5f1a5a-eb66-4933-9224-af883fa707f7> a ns1:Besluit ;
    ns3:description """ 
                                                    Het college van burgemeester en schepenen bekrachtigt de politieverordening bij hoogdringendheid, genomen door de burgemeester op 13/05 voor de organisatie van Carwash Scouts Gooik op 17/05 
                                                """ ;
    ns3:language <http://publications.europa.eu/resource/authority/language/NLD> ;
    ns3:passed_by <http://data.lblod.info/id/bestuursorganen/1cd382ca-87a9-4693-8216-a4e5e16af3fa> ;
    ns3:title "Bekrachtiging politieverordening bij hoogdringendheid voor de organisatie van Carwash Scouts Gooik op17/05" ;
    ns1:motivering """ 
                                 
                                    Aan het college van burgemeester en schepenen wordt gevraagd de politieverordening bij hoogdringendheid, genomen door de burgemeester op 13/05, te bekrachtigen. 
                                 
                            """@nl ;
    ns2:uuid "c27207ba-c2f1-5040-8c9f-ebd14caa5f2e" ;
    prov:value """ 
                                 
                                    Artikel 1 - Het college van burgemeester en schepenen bekrachtigt de politieverordening bij hoogdringendheid, genomen door de burgemeester op 13/05 voor de organisatie van Carwash Scouts Gooik op 17/05. 
                                    Artikel 2 - Volgende verkeersmaatregelen worden getroffen op 17/5 tussen 7u en 17u:  
                                    Parkeerverbod E3 op parking tussen rondpunt en Delhaize Gooik. 
                                 
                            """ ;
    prov:wasGeneratedBy <https://pajottegem-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/6e5f1a5a-eb66-4933-9224-af883fa707f7> .


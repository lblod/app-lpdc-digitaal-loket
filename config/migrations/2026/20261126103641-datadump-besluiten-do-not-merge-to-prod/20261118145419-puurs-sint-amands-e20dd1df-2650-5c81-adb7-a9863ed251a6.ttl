<https://puurs-sint-amands-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/4a03f6b6-7292-4b09-beb3-f22cffcd286b> a ns1:BehandelingVanAgendapunt ;
    ns1:gebeurtNa <https://puurs-sint-amands-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/3d46af28-0076-4ab4-aaab-22aa5c070c39> ;
    ns1:openbaar true ;
    ns2:uuid "3c11d67a-6b99-5e7f-97ef-f9c45472c47d" ;
    dcterms:subject <https://puurs-sint-amands-echo.cipalschaubroeck.be/id/agendapunten/4a03f6b6-7292-4b09-beb3-f22cffcd286b> ;

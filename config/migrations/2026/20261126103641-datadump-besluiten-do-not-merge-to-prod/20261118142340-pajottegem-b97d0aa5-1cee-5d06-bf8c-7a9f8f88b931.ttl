<https://pajottegem-echo.cipalschaubroeck.be/id/besluiten/b2461d80-32da-4724-a430-978db06afc30> a ns1:Besluit,
        <https://data.vlaanderen.be/id/concept/BesluitType/256bd04a-b74b-4f2a-8f5d-14dda4765af9> ;
    ns2:description """ 
                                                    Het college keurt de politieverordening met tijdelijke verkeersmaatregelen voor de Duoloop JCO op donderdag 29 mei 2025 goed. 
                                                """ ;
    ns2:language <http://publications.europa.eu/resource/authority/language/NLD> ;
    ns2:passed_by <http://data.lblod.info/id/bestuursorganen/1cd382ca-87a9-4693-8216-a4e5e16af3fa> ;
    ns2:title "Politieverordening: Duoloop JCO - donderdag 29 mei 2025" ;
    ns1:motivering """ 
                            """@nl ;
    ns3:uuid "b97d0aa5-1cee-5d06-bf8c-7a9f8f88b931" ;
    prov:value """ 
                                 
                                    
                                        Artikel 1 - Ter gelegenheid van Duoloop JCO op donderdag 29 mei 2025 worden volgende beperkingsmaatregelen voor het verkeer genomen van 14u tot 18u:
                                     
                                     
                                        Op de Kloosterstraat tussen de oude trambedding en het Kerkplein langs beide zijden van de weg geldt: 
                                        Op de Kerkstraat tussen het Kerkplein en de bocht ingang kerkhof  langs beide zijden van de weg geldt: 
                                        Op de Blijkheerstraat tussen de Vollezelestraat en de Opperstebosstraat langs zijde pare huisnummers geldt: 
                                        Op de Turkeyestraat  langs beide zijden van de weg geldt: 
                                        Op het volledige Kerkplein geldt: 
                                        het stilstaan en parkeren is verboden;het begin van de parkeerreglementering wordt aangeduid;de parkeerreglementering geldt over een afstand van meer dan 300 meter.Dit wordt gesignaleerd door:- verkeersborden E3- de verkeersborden worden aangevuld met x-borden Xa, Xb en Xd 
                                        
                                            Op de Kerkstraat tussen de Kasteeldreef en de Kervijnstraat geldt:
                                         
                                        
                                            Op de Kervijnstraat tussen de Pastoriestraat en de Kerkstraat geldt:
                                         
                                         
                                            de toegang is verboden in beide richtingen, voor iedere bestuurder, uitgezonderd plaatselijk verkeer.Dit wordt gesignaleerd door:- verkeersborden C3 
                                            Op de Kerkstraat tussen de Kervijnstraat en het Kerkplein geldt: 
                                            Op het Kerkplein tussen de Pastoriestraat en de Kloosterstraat geldt: 
                                            Op de Kloosterstraat tussen het Kerkplein en de Vollezelestraat geldt: 
                                            de toegang is verboden in beide richtingen, voor iedere bestuurder.Dit wordt gesignaleerd door:- verkeersborden C3 
                                         
                                        Artikel 2 - De signalisatie zal worden aangeleverd door de gemeentediensten volgens het voorstel van de lokale politiezone Pajottenland, overeenkomstig de wettelijke voorschriften. 
                                     
                                     
                                        Artikel 3 - Te voorzien door de organisatoren: 
                                         
                                             De bewoners langsheen de straten waar er verkeersmaatregelen worden ingevoerd, moeten minstens 48 uur op voorhand schriftelijk op de hoogte worden gebracht van het evenement en van de verkeersmaatregelen.  
                                             Alle tijdelijk voorziene verkeersborden en hekkens dienen door de organisatoren volgens het voorstel van de Lokale Politiezone Pajottenland, overeenkomstig de wettelijke voorschriften voor het evenement geplaatst en onmiddellijk na het evenement te worden verwijderd of afgedekt.  
                                         
                                     
                                 
                            """ ;
    prov:wasGeneratedBy <https://pajottegem-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/b2461d80-32da-4724-a430-978db06afc30> .


    dcterms:description """ 
                                                             
                                                                De mail d.d. 2 mei 2025 vanwege de assistent algemeen directeur van De Lijn betreffende de uitnodiging tot deelname aan de 34e Algemene Vergadering van aandeelhouders van de Vlaamse Vervoermaatschappij De Lijn. 
                                                             
                                                        """ ;
    dcterms:subject <https://brakel-echo.cipalschaubroeck.be/id/agendapunten/30551822-c500-49d1-bc0a-094708fed392> ;

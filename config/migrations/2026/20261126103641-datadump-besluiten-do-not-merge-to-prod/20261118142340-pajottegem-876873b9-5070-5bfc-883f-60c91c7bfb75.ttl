<https://pajottegem-echo.cipalschaubroeck.be/id/besluiten/d36866ca-f0b1-4e33-8381-a7222d0fbaa8> a ns1:Besluit,
        <https://data.vlaanderen.be/id/concept/BesluitType/256bd04a-b74b-4f2a-8f5d-14dda4765af9> ;
    ns2:description """ 
                                                    Het college keurt de politieverordening met tijdelijke verkeersmaatregelen voor de Inhuldiging beeld Paardenprocessie Kester op 31 mei 2025 goed. 
                                                """ ;
    ns2:language <http://publications.europa.eu/resource/authority/language/NLD> ;
    ns2:passed_by <http://data.lblod.info/id/bestuursorganen/1cd382ca-87a9-4693-8216-a4e5e16af3fa> ;
    ns2:title "Politieverordening: Inhuldiging beeld Paardenprocessie Kester - 31 mei 2025" ;
    ns1:motivering """ 
                            """@nl ;
    ns3:uuid "876873b9-5070-5bfc-883f-60c91c7bfb75" ;
    prov:value """ 
                                 
                                    
                                        Artikel 1 - Ter gelegenheid van Inhuldiging beeld Paardenprocessie Kester op 31 mei 2025 worden volgende beperkingsmaatregelen voor het verkeer genomen:
                                     
                                    
                                         
                                     
                                    
                                        Op het volledige plein voor de kerk te Kester met uitzondering van het langs parkeren tussen huisnummers 80 en 74 geldt:
                                     
                                    
                                         
                                     
                                    
                                        het stilstaan en parkeren is verboden;
                                        het begin van de parkeerreglementering wordt aangeduid;
                                        Dit wordt gesignaleerd door:
                                        - verkeersborden E3
                                        - de verkeersborden worden aangevuld met x-borden Xa, Xd
                                     
                                    
                                         
                                     
                                    
                                        Op de Bruneaustraat (N272) tussen de Edingsesteenweg (N272) en de Oude Molenstraat geldt:
                                     
                                    
                                        de toegang is verboden in beide richtingen, voor iedere bestuurder, uitgezonderd plaatselijk verkeer.
                                        Dit wordt gesignaleerd door:
                                        - verkeersborden C3
                                     
                                    
                                        - onderbord type IV
                                     
                                    
                                         
                                     
                                     
                                        
                                            Op de Bruneaustraat (N272) tussen de Cypriaan Verhavertstraat en de Oude Molenstraat geldt:
                                         
                                        
                                            de toegang is verboden in beide richtingen, voor iedere bestuurder.
                                            Dit wordt gesignaleerd door:
                                            - verkeersborden C3
                                         
                                        
                                             
                                         
                                        
                                            Artikel 2 - De signalisatie zal worden aangeleverd door de gemeentediensten volgens het voorstel van de lokale politiezone Pajottenland, overeenkomstig de wettelijke voorschriften.
                                         
                                     
                                     
                                        Artikel 3 - Te voorzien door de organisatoren: 
                                         
                                             De bewoners langsheen de straten waar er verkeersmaatregelen worden ingevoerd, moeten minstens 48 uur op voorhand schriftelijk op de hoogte worden gebracht van het evenement en van de verkeersmaatregelen.  
                                             Alle tijdelijk voorziene verkeersborden en hekkens dienen door de organisatoren volgens het voorstel van de Lokale Politiezone Pajottenland, overeenkomstig de wettelijke voorschriften voor het evenement geplaatst en onmiddellijk na het evenement te worden verwijderd of afgedekt.  
                                         
                                     
                                 
                            """ ;
    prov:wasGeneratedBy <https://pajottegem-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/d36866ca-f0b1-4e33-8381-a7222d0fbaa8> .


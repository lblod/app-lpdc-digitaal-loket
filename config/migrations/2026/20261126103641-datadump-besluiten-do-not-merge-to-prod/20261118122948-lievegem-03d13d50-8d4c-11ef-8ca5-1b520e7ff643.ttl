<https://lievegem-echo.cipalschaubroeck.be/id/besluiten/52db49ba-707a-4b4c-a785-2edec5ffa451> a ns2:Besluit ;
    ns3:description """ 
                                                    De algemeen directeur legt in openbare vergadering in handen van de voorzitter de eed af. 
                                                """ ;
    ns3:language <http://publications.europa.eu/resource/authority/language/NLD> ;
    ns3:passed_by <http://data.lblod.info/id/bestuursorganen/15081fa9-4889-4e4d-a7cc-9708549e4847> ;
    ns3:title "Algemeen directeur: eedaflegging" ;
    ns2:motivering """ 
                                                         
                                                            Bevoegd lid 
                                                            Kim Martens, burgemeester 
                                                            Hilde De Graeve, schepen 
                                                         
                                                         
                                                            Regelgeving 
                                                            Het decreet van 22 december 2017 over het lokaal bestuur, artikel 28 §2, 41, 6°, artikel 163 
                                                            Het gemeenteraadsbesluit van 3 juli 2019 over Personeel rechtspositieregeling gemeente Lievegem: goedkeuring, gewijzigd op 1 juli 2020, 18 november 2020, 24 november 2021 en 14 september 2022, meer bepaald artikel 49 
                                                            Het gemeenteraadsbesluit van 31 januari 2024 over Personeel - aanstelling van een voltijds statutair algemeen directeur voor gemeente en OCMW: goedkeuring 
                                                            Het gemeenteraadsbesluit van 24 april 2024 over Personeel - aanstelling van een voltijds statutair algemeen directeur voor gemeente en OCMW - datum indiensttreding en individuele weddevaststelling: goedkeuring 
                                                         
                                                         
                                                            Feiten en motivering 
                                                            In de gemeenteraad van 31 januari 2024 werd Kenneth Pauwels aangesteld als algemeen directeur met ingang van 1 juni 2024. 
                                                            De algemeen directeur legt na zijn aanstelling tijdens de openbare vergadering van de gemeenteraad de eed af in handen van de voorzitter van de gemeenteraad. 
                                                         
                                                    """@nl ;
    ns1:uuid "03d13d50-8d4c-11ef-8ca5-1b520e7ff643" ;
    prov:value """ 
                                                         
                                                            Besluit 
                                                            Artikel 1 
                                                            Kenneth Pauwels, algemeen directeur, legt in handen van de voorzitter, Nicholas Spinel, de volgende eed af: "Ik zweer de verplichtingen van mijn ambt trouw na te komen". 
                                                            Artikel 2 
                                                            Van de eedaflegging wordt een afzonderlijk proces-verbaal opgemaakt. 
                                                         
                                                    """ ;
    prov:wasGeneratedBy <https://lievegem-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/52db49ba-707a-4b4c-a785-2edec5ffa451> .


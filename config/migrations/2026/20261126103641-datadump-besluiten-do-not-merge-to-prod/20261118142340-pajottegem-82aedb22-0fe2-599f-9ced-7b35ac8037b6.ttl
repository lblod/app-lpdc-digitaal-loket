<https://pajottegem-echo.cipalschaubroeck.be/id/besluiten/d2980546-7251-46c6-9db1-281ef68b2f6f> a ns1:Besluit,
        <https://data.vlaanderen.be/id/concept/BesluitType/256bd04a-b74b-4f2a-8f5d-14dda4765af9> ;
    ns2:description """ 
                                                    Het college keurt de politieverordening met tijdelijke verkeersmaatregelen voor de Jogging op 17 mei 2025 goed. 
                                                """ ;
    ns2:language <http://publications.europa.eu/resource/authority/language/NLD> ;
    ns2:passed_by <http://data.lblod.info/id/bestuursorganen/1cd382ca-87a9-4693-8216-a4e5e16af3fa> ;
    ns2:title "Politieverordening: Kwadebeekjogging - 17 mei 2025" ;
    ns1:motivering """ 
                            """@nl ;
    ns3:uuid "82aedb22-0fe2-599f-9ced-7b35ac8037b6" ;
    prov:value """ 
                                 
                                    
                                        Artikel 1 - Ter gelegenheid van Jogging op 17 mei 2025 worden volgende beperkingsmaatregelen voor het verkeer genomen vanaf 13u00 tot 18u:
                                     
                                    
                                         
                                     
                                    
                                        Verbod tot stilstaan en parkeren (E3) op volgende straten:
                                     
                                    
                                         
                                     
                                    
                                        Winnepenninckxstraat
                                     
                                    
                                        Havilandstraat 
                                     
                                    
                                        Tramstraat
                                     
                                    
                                        Kerkveldstraat
                                     
                                    
                                        Kwadebeekstraat
                                     
                                    
                                        Nattebroekstraat
                                     
                                    
                                         
                                     
                                    
                                        Verboden af te slaan naar links/rechts (C31a/b):
                                     
                                    
                                         
                                     
                                    
                                        KP Ninoofse Steenweg naar Winnepennickxstraat
                                     
                                    
                                        KP Edingsesteenweg naar Nattebroekstraat
                                     
                                    
                                        KP Edingsesteenweg naar Kerkveldstraat
                                     
                                    
                                        KP Edingsesteenweg naar Kwadebeekstraat
                                     
                                    
                                         
                                     
                                    
                                        Verboden toegang voor alle verkeer, uitgezonderd plaatselijk verkeer, doodlopende straat (C3 + F45 + 'UPV'):
                                     
                                    
                                         
                                     
                                    
                                        Nattebroekstraat
                                     
                                    
                                        Kerkveldstraat
                                     
                                    
                                        Kwadebeekstraat
                                     
                                    
                                         
                                     
                                    
                                        Verboden toegang voor alle verkeer (nadar + C3):
                                     
                                    
                                         
                                     
                                    
                                        KP Winnepennickxstraat/Ninoofse Steenweg
                                     
                                    
                                        KP Kerkveldstraat/Tramstraat
                                     
                                    
                                        Kwadebeekstraat t.h.v. huisnummer 17
                                     
                                    
                                        KP Kwadebeekstraat/Nattebroekstraat
                                     
                                    
                                        KP Putbeekstraat/Nattebroekstraat
                                     
                                    
                                        Winnepenninckxstraat t.h.v. huisnummer 40
                                     
                                    
                                        KP Winnepennickxstraat/Winnepennickxstraat
                                     
                                    
                                         
                                     
                                     
                                         
                                            Artikel 2 - De signalisatie zal worden aangeleverd door de gemeentediensten volgens het voorstel van de lokale politiezone Pajottenland, overeenkomstig de wettelijke voorschriften. 
                                         
                                        Artikel 3 - Te voorzien door de organisatoren: 
                                         
                                             De bewoners langsheen de straten waar er verkeersmaatregelen worden ingevoerd, moeten minstens 48 uur op voorhand schriftelijk op de hoogte worden gebracht van het evenement en van de verkeersmaatregelen.  
                                             Alle tijdelijk voorziene verkeersborden en hekkens dienen door de organisatoren volgens het voorstel van de Lokale Politiezone Pajottenland, overeenkomstig de wettelijke voorschriften voor het evenement geplaatst en onmiddellijk na het evenement te worden verwijderd of afgedekt.  
                                         
                                     
                                 
                            """ ;
    prov:wasGeneratedBy <https://pajottegem-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/d2980546-7251-46c6-9db1-281ef68b2f6f> .


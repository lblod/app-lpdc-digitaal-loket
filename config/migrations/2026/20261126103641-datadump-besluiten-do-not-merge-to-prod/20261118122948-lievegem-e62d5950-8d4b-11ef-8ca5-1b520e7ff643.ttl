<https://lievegem-echo.cipalschaubroeck.be/id/besluiten/2371935b-7ad6-4871-af1c-8089e789c391> a ns2:Besluit ;
    ns1:description """ 
                                                    De gemeenteraad keurt de toetreding van gemeente Maldegem tot projectvereniging Meetjesman goed. 
                                                """ ;
    ns1:language <http://publications.europa.eu/resource/authority/language/NLD> ;
    ns1:passed_by <http://data.lblod.info/id/bestuursorganen/15081fa9-4889-4e4d-a7cc-9708549e4847> ;
    ns1:title "Projectvereniging Meetjesman - vraag tot toetreding gemeente Maldegem: goedkeuring" ;
    ns2:motivering """ 
                                                         
                                                            Bevoegd lid 
                                                            Caroline Fredrick, schepen 
                                                         
                                                         
                                                            Regelgeving 
                                                            Het besluit van de gemeenteraad van 20 november 2019 over de goedkeuring van de oprichting van de projectvereniging MeetjesmanHet besluit van het college van burgemeester en schepenen van 9 januari 2024 over principiële goedkeuring vraag tot toetreding gemeente Maldegem bij Meetjesman  
                                                         
                                                         
                                                            Feiten en motivering 
                                                            Op 23 november 2023 keurde de gemeenteraad van Maldegem de toetreding tot projectvereniging Meetjesman goed. Deze vraag tot toetreding werd op de raad van bestuur van projectvereniging Meetjesman voorgelegd op 12 december 2023. De raad van bestuur Meetjesman ging unaniem over tot de voorlopige aanvaarding van gemeente Maldegem als negende lid van projectvereniging Meetjesman. 
                                                            Conform de statuten van Meetjesman moet elke gemeenteraad van de deelnemende gemeenten de aanvaarding van een nieuw lid bespreken.De raad van bestuur van de projectvereniging Meetjesman geeft een positief advies over de toetreding van gemeente Maldegem. 
                                                            Team Jeugd is er van overtuigd dat het uitbreiden van de regio kan leiden tot een sterkere jeugdregio, zodat we samen kunnen inzetten op een sterk beleid voor jonge inwoners in het Meetjesland 
                                                         
                                                    """@nl ;
    ns3:uuid "e62d5950-8d4b-11ef-8ca5-1b520e7ff643" ;
    prov:value """ 
                                                         
                                                            Besluit 
                                                            Enig artikelDe gemeenteraad keurt de toetreding van gemeente Maldegem tot projectvereniging Meetjesman goed. 
                                                         
                                                    """ ;
    prov:wasGeneratedBy <https://lievegem-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/2371935b-7ad6-4871-af1c-8089e789c391> .


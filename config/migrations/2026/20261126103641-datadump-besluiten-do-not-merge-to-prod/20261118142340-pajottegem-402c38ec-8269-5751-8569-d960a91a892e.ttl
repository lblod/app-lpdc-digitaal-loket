<https://pajottegem-echo.cipalschaubroeck.be/id/besluiten/306f7478-0007-4a23-afbe-d60a62c7ebf7> a ns1:Besluit ;
    ns2:description """ 
                                                    Het college van burgemeester en schepenen keurt de politieverordening met tijdelijke verkeersmaatregelen voor de vinkenzettingen goed. 
                                                """ ;
    ns2:language <http://publications.europa.eu/resource/authority/language/NLD> ;
    ns2:passed_by <http://data.lblod.info/id/bestuursorganen/1cd382ca-87a9-4693-8216-a4e5e16af3fa> ;
    ns2:title "Tijdelijke politieverordening: vinkenzetting Schoolstraat, 1570 Pajottegem - periode 2026" ;
    ns1:motivering """ 
                                 
                                      
                                    
                                         
                                     
                                     
                                 
                            """@nl ;
    ns3:uuid "402c38ec-8269-5751-8569-d960a91a892e" ;
    prov:value """ 
                                 
                                    Enig artikel - Ter gelegenheid van de vinkenzettingen worden volgende beperkingsmaatregelen voor het verkeer genomen van 8.30 uur tot 10.30 uur op: 
                                     
                                        Zaterdag 18 april 2026 
                                        Zondag 26 april 2026 
                                        Zondag 3 mei 2026 
                                        Zondag 10 mei 2026 
                                        Zondag 17 mei 2026 
                                        Zondag 24 mei 2026 
                                        Zondag 31 mei 2026 
                                        Zondag 7 juni 2026 
                                        Zondag 14 juni 2026 
                                        Zondag 21 juni 2026 
                                        Zondag 28 juni 2026 
                                        Zondag 5 juli 2026 
                                        Zondag 12 juli 2026 
                                        Zondag 19 juli 2026 
                                        Zondag 26 juli 2026 
                                     
                                    Op de Schoolstraat deel na de zijstraat met de bareel geldt:          verboden toegang voor iedere bestuurderDit wordt gesignaleerd door: 
                                     
                                        verkeersborden C3 
                                     
                                    
                                         
                                     
                                    
                                         
                                     
                                    
                                        Artikel 2 - De signalisatie zal worden aangeleverd door de gemeentediensten volgens het voorstel van de lokale politiezone Pajottenland, overeenkomstig de wettelijke voorschriften.
                                     
                                    
                                         
                                     
                                    
                                         
                                     
                                     
                                        Artikel 3 - Te voorzien door de organisatoren: 
                                         
                                            De bewoners langsheen de straten waar er verkeersmaatregelen worden ingevoerd, moeten minstens 48 uur op voorhand schriftelijk op de hoogte worden gebracht van het evenement en van de verkeersmaatregelen. 
                                            Alle tijdelijk voorziene verkeersborden en hekkens dienen door de organisatoren volgens het voorstel van de Lokale Politiezone Pajottenland, overeenkomstig de wettelijke voorschriften voor het evenement geplaatst en onmiddellijk na het evenement te worden verwijderd of afgedekt. 
                                         
                                     
                                 
                            """ ;

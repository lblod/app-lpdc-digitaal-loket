        """ 
                                                             
                                                                Op zaterdag 25 januari 2025 diende de kerkfabriek Sint-Marie - deelgemeente Everbeek-Beneden haar meerjarenplanwijziging 2025 in. 
                                                                
                                                                     
                                                                 
                                                             
                                                        """ ;
    dcterms:subject <https://brakel-echo.cipalschaubroeck.be/id/agendapunten/6655e332-7503-4a9b-8be4-8f5b98a53f45> ;

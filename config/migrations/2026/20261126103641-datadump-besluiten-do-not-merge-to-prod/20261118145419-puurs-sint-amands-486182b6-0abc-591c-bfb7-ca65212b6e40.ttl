    ns3:passed_by <http://data.lblod.info/id/bestuursorganen/2e5c95ecec50764ebb1b6b35d655a246117522a7e6c0e118a88766874dd78acb> ;
    ns3:title "Aanvullend verkeersreglement - Coolhemstraat: oversteekplaats voor voetgangers" ;
    ns1:motivering """ 
                                 
                                    Aanleiding 
                                    Op vraag van de scouts Kalfort  werd de piste voor een zebrapad onderzocht ter hoogte Coolhemstraat 53. Aangezien dit ook een toegangsweg is voor het toekomstige parkgebied en eveneens gebruikt kan worden in functie van de nieuwe ligging voor Chiro Kalfort, willen we de oversteekplaats zo veilig mogelijk faciliteren. 
                                 
                                 
                                    Juridische grond 
                                     
                                         
                                            Volgende bevoegdheidsgrond en regelgeving is van toepassing:  
                                         
                                         
                                            Bevoegdheidsgrond  
                                             
                                                Het Decreet over het lokaal bestuur van 22 december 2017, artikel 56, §2 
                                                Het decreet van 16 mei 2008 betreffende de aanvullende reglementen op het wegverkeer en de plaatsing en bekostiging van de verkeerstekens, artikel 4; 
                                                Gemeenteraadsbeslissing van 27 januari 2025: Gemeentelijke aanvullende reglementen op de politie over het wegverkeer - Delegatie van de bevoegdheid aan het college van burgemeester en schepenen; 
                                             
                                            Toepasselijke regelgeving 
                                         
                                     
                                     
                                         
                                            de wet betreffende de politie over het wegverkeer, gecoördineerd bij koninklijk besluit van 16 maart 1968; 
                                            het koninklijk besluit van 1 december 1975 houdende algemeen reglement op de politie van het wegverkeer en van het gebruik van de openbare weg; 
                                            het ministerieel besluit van 11 oktober 1976 waarbij de minimumafmetingen en de bijzondere plaatsingsvoorwaarden van de verkeerstekens worden bepaald; 
                                            het decreet van 16 mei 2008 betreffende de aanvullende reglementen op het wegverkeer en de plaatsing en bekostiging van de verkeerstekens; 
                                            het uitvoeringsbesluit van 23 januari 2009 betreffende de aanvullende reglementen op het wegverkeer en de plaatsing en bekostiging van de verkeerstekens; 
                                            de omzendbrief MOB/2009/1 van 3 april 2009; 
                                            de nieuwe gemeentewet van 24 juni 1988; 
                                         
                                     
                                 
                                 
                                    Feiten, context en argumentatie 
                                    Op vraag van de scouts Kalfort werd de piste voor een zebrapad onderzocht ter hoogte Coolhemstraat 53. Aangezien dit ook een toegangsweg is voor het toekomstige parkgebied en eveneens gebruikt kan worden in functie van de nieuwe ligging voor Chiro Kalfort, willen we de oversteekplaats zo veilig mogelijk faciliteren. 
                                    De hiërarchie der wegen zoals vastgelegd in het gemeentelijk mobiliteitsplan, verbreed en verdiept door het mobiliteitsplan Klein-Brabant, waarbij de straten het statuut kregen van lokale wegen type 2. 
                                 
                            """@nl ;
    ns2:uuid "486182b6-0abc-591c-bfb7-ca65212b6e40" ;
    prov:value """ 
                                 
                                    Besluit 
                                    Artikel 1: Thv Coolhemstraat nr.53 wordt volgende maatregel ingevoerd: een oversteekplaats voor voetgangers 
                                    Artikel 2: De oversteekplaats voor voetgangers wordt aangeduid voor verkeerstekens: 
                                    -       WM76.3 (zebrapad) 
                                    Artikel 3: Dit aanvullend verkeersreglement wordt overgemaakt aan het Departement Mobiliteit en Openbare Werken (MOW) via het loket lokale besturen. 
                                 
                            """ ;

<https://pajottegem-echo.cipalschaubroeck.be/id/besluiten/0056e73c-8846-4e9a-89c0-4c48e493907f> a ns3:Besluit,
        <https://data.vlaanderen.be/id/concept/BesluitType/256bd04a-b74b-4f2a-8f5d-14dda4765af9> ;
    ns1:description """ 
                                                    Het college keurt de politieverordening met tijdelijke verkeersmaatregelen voor de stoet en optocht op 6 juni 2025 goed. 
                                                """ ;
    ns1:language <http://publications.europa.eu/resource/authority/language/NLD> ;
    ns1:passed_by <http://data.lblod.info/id/bestuursorganen/1cd382ca-87a9-4693-8216-a4e5e16af3fa> ;
    ns1:title "Politieverordening: Meiboomplanting 2025 - 6 juni 2025" ;
    ns3:motivering """ 
                            """@nl ;
    ns2:uuid "41f53ce5-5197-5077-975c-386504e9cc29" ;
    prov:value """ 
                                 
                                    
                                        Artikel 1 - Ter gelegenheid van Stoet en optocht op 6 juni 2025 worden volgende beperkingsmaatregelen voor het verkeer genomen vanaf 18.00 uur:
                                     
                                    
                                         
                                     
                                    
                                          
                                        
                                            Stilstaan- en parkeerverbod wordt ingelast op 6-06-2025 18.00 uur tot 06-06-2025 23.00 uur in volgende straat:
                                         
                                        
                                             
                                         
                                        
                                            Marktplein
                                         
                                        
                                            Valt onder signalisatieplan Hapje Tapje.
                                         
                                        
                                             
                                         
                                        
                                            Parking Administratief huis
                                         
                                        
                                            Stilstaan en parkeren verboden 5 parkeerplaatsen achteraan de parking.
                                         
                                        
                                             
                                         
                                        
                                             
                                         
                                        
                                            Omleiding 
                                         
                                        
                                            Omleiding valt onder signalisatieplan Pinksterkermis.
                                         
                                     
                                    
                                         
                                     
                                    
                                         
                                     
                                     
                                         
                                            Artikel 2 - De signalisatie zal worden aangeleverd door de gemeentediensten volgens het voorstel van de lokale politiezone Pajottenland, overeenkomstig de wettelijke voorschriften. 
                                             
                                         
                                        Artikel 3 - Te voorzien door de organisatoren: 
                                         
                                             De bewoners langsheen de straten waar er verkeersmaatregelen worden ingevoerd, moeten minstens 48 uur op voorhand schriftelijk op de hoogte worden gebracht van het evenement en van de verkeersmaatregelen.  
                                             Alle tijdelijk voorziene verkeersborden en hekkens dienen door de organisatoren volgens het voorstel van de Lokale Politiezone Pajottenland, overeenkomstig de wettelijke voorschriften voor het evenement geplaatst en onmiddellijk na het evenement te worden verwijderd of afgedekt.  
                                         
                                     
                                 
                            """ ;
    prov:wasGeneratedBy <https://pajottegem-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/0056e73c-8846-4e9a-89c0-4c48e493907f> .


    dcterms:description """ 
                                                             
                                                                Via e-mail én het aangetekend schrijven op 11 december 2024 werd de gemeente Brakel opgeroepen om deel te nemen aan de Buitengewone Algemene Vergadering van Creat Services dv d.d. 25 maart 2025. 
                                                             
                                                        """ ;
    dcterms:subject <https://brakel-echo.cipalschaubroeck.be/id/agendapunten/d5a94fe9-97f4-463e-bcb6-862733fc0afc> ;

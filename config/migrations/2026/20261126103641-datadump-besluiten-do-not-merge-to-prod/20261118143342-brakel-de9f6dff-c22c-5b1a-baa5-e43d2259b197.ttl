<https://brakel-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/248501d3-e7a9-40f3-9eaa-b1ab921229dd> a ns1:BehandelingVanAgendapunt ;
    ns1:gebeurtNa <https://brakel-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/48aeb379-fd0b-4380-a05f-7cc158cda529> ;

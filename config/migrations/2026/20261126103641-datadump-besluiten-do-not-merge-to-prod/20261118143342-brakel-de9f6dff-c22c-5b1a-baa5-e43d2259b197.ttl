    dcterms:description """ 
                                                             
                                                                Het aangetekend schrijven d.d. 10 maart 2025 en de mail d.d. 11 mei 2025 vanwege IVLA waarbij de gemeente Brakel wordt uitgenodigd om deel te nemen aan de Algemene Vergadering d.d. 06 mei 2025. 
                                                                
                                                                     
                                                                 
                                                             
                                                        """ ;
    dcterms:subject <https://brakel-echo.cipalschaubroeck.be/id/agendapunten/248501d3-e7a9-40f3-9eaa-b1ab921229dd> ;

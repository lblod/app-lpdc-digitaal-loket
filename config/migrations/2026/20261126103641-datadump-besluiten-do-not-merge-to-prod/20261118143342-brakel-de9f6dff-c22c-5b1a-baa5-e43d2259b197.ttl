<https://brakel-echo.cipalschaubroeck.be/id/besluiten/248501d3-e7a9-40f3-9eaa-b1ab921229dd> a ns1:Besluit,
        <https://data.vlaanderen.be/id/concept/BesluitType/e96ec8af-6480-4b32-876a-fefe5f0a3793> ;
    ns2:language <http://publications.europa.eu/resource/authority/language/NLD> ;
    ns2:passed_by <http://data.lblod.info/id/bestuursorganen/59b1dacf1caa0dd64b2a30cb8cea4c20ec24ea245289789b3dcb24ecb4e272c8> ;
    ns2:title "Samenwerkingsverbanden. IVLA. Uitnodiging Algemene Vergadering d.d. 06 mei 2025. Goedkeuring." ;
    ns1:motivering """ 
                                                                 
                                                                    Regelgeving en bevoegdheid 
                                                                    Het Decreet Lokaal Bestuur van 22 december 2017; 
                                                                 
                                                                 
                                                                    Feiten, context en argumentatie 
                                                                    - Het Raadsbesluit d.d. 03 februari 2025 betreffende de aanstelling vertegenwoordiger en plaatsvervanger voor de Algemene Vergadering; 
                                                                    - Het aangetekend schrijven d.d. 10 maart 2025 vanwege IVLA waarbij de gemeente Brakel wordt uitgenodigd om deel te nemen aan de Algemene Vergadering d.d. 06 mei 2025 
                                                                      
                                                                    De bijgevoegde agenda van voormelde vergadering zijnde: 
                                                                     
                                                                        Benoeming bestuurder Kruisem 
                                                                        Aanstelling commissaris-revisor 
                                                                     
                                                                    -Het College van Burgemeester en Schepenen d.d. 17 maart 2025 nam kennis van de uitnodiging en de agenda met bijhorende stukken van de Algemene Vergadering van IVLA d.d. 06 mei 2025. 
                                                                 
                                                            """@nl ;
    ns3:uuid "de9f6dff-c22c-5b1a-baa5-e43d2259b197" ;
    prov:value """ 
                                                                 
                                                                    Besluit 
                                                                    Art. 1: De agenda en alle bijhorende stukken van de Algemene vergadering van IVLA d.d. 06 mei 2025 wordt goedgekeurd. 
                                                                    Art. 2: De vertegenwoordiger van de gemeente die zal deelnemen aan de algemene vergadering wordt opgedragen haar stemgedrag af te stemmen op de beslissing genomen zoals in artikel 1 van dit besluit.  
                                                                    Art. 3: Afschrift van deze beslissing zal toegestuurd worden aan het secretariaat van IVLA. 
                                                                 
                                                            """ ;
    prov:wasGeneratedBy <https://brakel-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/248501d3-e7a9-40f3-9eaa-b1ab921229dd> .


<https://brakel-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/84db1bee-f8ce-47d1-adc9-98f9f5077511> a ns1:BehandelingVanAgendapunt ;
    ns1:gebeurtNa <https://brakel-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/5caf5b90-2c88-4a27-878b-e16fded7f548> ;

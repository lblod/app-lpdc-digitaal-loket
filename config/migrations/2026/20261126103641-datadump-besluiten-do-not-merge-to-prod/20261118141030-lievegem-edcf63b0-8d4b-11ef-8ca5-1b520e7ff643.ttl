<https://lievegem-echo.cipalschaubroeck.be/id/besluiten/4c93144e-5a19-470b-93d1-7e2659266b01> a ns1:Besluit ;
    ns3:description """ 
                                                    De raad neemt kennis van de nieuwe fractieleider van N-VA. 
                                                """ ;
    ns3:language <http://publications.europa.eu/resource/authority/language/NLD> ;
    ns3:passed_by <http://data.lblod.info/id/bestuursorganen/15081fa9-4889-4e4d-a7cc-9708549e4847> ;
    ns3:title "N-VA - wijziging fractieleider: kennisname" ;
    ns1:motivering """ 
                                                         
                                                            Bevoegd lid 
                                                            Nicholas Spinel, voorzitter 
                                                         
                                                         
                                                            Regelgeving 
                                                            Decreet van 22 december 2017 over het lokaal bestuur, artikel 36 
                                                            Omzendbrief KB / ABB 2018 / 3 van 26 oktober 2018 over de start van de lokale en provinciale bestuursperiode. 
                                                            Gemeenteraadsbesluit van heden over de kennisname van het ontslag van Maikel Parmentier als raadslid 
                                                         
                                                         
                                                            Feiten en motivering 
                                                            Er zetelen 5 fracties in de gemeenteraad.Fractieleider N-VA was Maikel ParmentierMaikel Parmentier meldde op 2 februari 2021 per e-mail :Véronique Mussche wordt de nieuwe fractieleider van de N-VA-fractie. 
                                                         
                                                    """@nl ;
    ns2:uuid "edcf63b0-8d4b-11ef-8ca5-1b520e7ff643" ;
    prov:value """ 
                                                         
                                                            Besluit 
                                                            Enig artikel 
                                                            De raad neemt kennis van de  nieuwe fractieleider van NV-A: 
                                                            Véronique Mussche 
                                                         
                                                    """ ;

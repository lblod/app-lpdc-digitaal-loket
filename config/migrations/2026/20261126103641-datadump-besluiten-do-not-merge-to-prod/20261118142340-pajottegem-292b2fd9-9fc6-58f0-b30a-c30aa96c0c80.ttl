<https://pajottegem-echo.cipalschaubroeck.be/id/besluiten/cbdc789f-3513-4c65-a10e-133f5a74d91f> a ns1:Besluit,
        <https://data.vlaanderen.be/id/concept/BesluitType/256bd04a-b74b-4f2a-8f5d-14dda4765af9> ;
    ns3:description """ 
                                                    Het college keurt de politieverordening met tijdelijke verkeersmaatregelen voor de Lokale wedstrijd - Open omloop - U17 op 25 mei 2025 goed. 
                                                """ ;
    ns3:language <http://publications.europa.eu/resource/authority/language/NLD> ;
    ns3:passed_by <http://data.lblod.info/id/bestuursorganen/1cd382ca-87a9-4693-8216-a4e5e16af3fa> ;
    ns3:title "Politieverordening: Wielerwedstrijd Neigem Pedaleert - 25 mei 2025" ;
    ns1:motivering """ 
                            """@nl ;
    ns2:uuid "292b2fd9-9fc6-58f0-b30a-c30aa96c0c80" ;
    prov:value """ 
                                 
                                    
                                        Artikel 1 - Ter gelegenheid van Lokale wedstrijd - Open omloop - U17 op 25 mei 2025 worden volgende beperkingsmaatregelen voor het verkeer genomen vanaf 10u tot 17u:
                                     
                                    
                                         
                                     
                                     
                                        Stilstaan- en parkeerverbod (fig E3) wordt ingelast van 10.00 uur tot 17.00 uur in volgende straten: 
                                        - Opperstenbosstraat 
                                        Stilstaan en parkeren verboden (fig E3) op de Opperstenbosstraat vanaf het kruispunt met de Oude Heerbaan tot Vreckom (grondgebied Ninove). 
                                        - Oude Heerbaan 
                                        Stilstaan en parkeren verboden (fig E3) op de Oude Heerbaan vanaf het kruispunt met de Opperstenbosstraat tot het kruispunt met de Hoevestraat. 
                                        - Hoevestraat 
                                        Stilstaan en parkeren verboden (fig E3) op de Hoevestraat vanaf het kruispunt met de Oude Heerbaan tot het kruispunt met de Ninoofse Steenweg. 
                                        - Strijlandstraat 
                                        Stilstaan en parkeren verboden (fig E3) op de Strijlandstraat vanaf het kruispunt met de Ninoofse Steenweg tot het kruispunt met de Terhagenstraat. 
                                        - Terhagenstraat 
                                        Stilstaan en parkeren verboden (fig E3) op de Terhagenstraat vanaf het kruispunt met de Strijlandstraat tot het kruispunt met de Kroonstraat. 
                                        - Kroonstraat 
                                        Stilstaan en parkeren verboden (fig E3) op de Kroonstraat vanaf het kruispunt met de Terhagenstraat tot het kruispunt met de Drie Egyptenbaan. 
                                        - Drie Egyptenbaan 
                                        Stilstaan en parkeren verboden (fig E3) op de Drie Egyptenbaan vanaf het kruispunt met de Kroonstraat tot de Brusselseheerweg (grondgebied Ninove). 
                                          
                                        Eénrichtingsverkeer (fig C1 + fig F19) wordt ingelast van 12.00 uur tot 16.00 uur in volgende straten: 
                                        - Drie Egyptenbaan 
                                        Verboden richting voor ieder bestuurder (fig C1) op de Drie Egyptenbaan vanaf de Brusselseheerweg (Ninove) tot het kruispunt met de Kroonstraat, 
                                        - Kroonstraat 
                                        Verboden richting voor ieder bestuurder (fig C1) op de Kroonstraat vanaf het kruispunt met de Drie Egyptenbaan tot het kruispunt met de Terhagenstraat. 
                                        - Terhagenstraat 
                                        Verboden richting voor ieder bestuurder (fig C1) op de Terhagenstraat vanaf het kruispunt met de Kroonstraat tot het kruispunt met de Strijlandstraat. 
                                        - Hoevestraat 
                                        Verboden richting voor ieder bestuurder (fig C1) op de Hoevestraat vanaf het kruispunt met de Ninoofse Steenweg (N28) tot het kruispunt met de Oude Heerbaan. 
                                        - Oude Heerbaan 
                                        Verboden richting voor ieder bestuurder (fig C1) op de Oude Heerbaan vanaf het kruispunt met de Hoevestraat tot het kruispunt met de Opperstenbosstraat. 
                                          
                                        Verbod aan het volgend kruispunt af te slaan in de richting door de pijl aangegeven (fig C31a / fig C31b) wordt ingelast van 12.00 uur tot 16.00 uur op volgende kruispunten: 
                                        - Kroonstraat 
                                        Drie Egyptenbaan / Kroonstraat 
                                        Kelenbergstraat / Kroonstraat 
                                        Gotestraat / Kroonstraat 
                                        - Terhagenstraat 
                                        Kroonstraat / Terhagenstraat 
                                        Terhagenstraat / Terhagenstraat 
                                        - Hoevestraat 
                                        Ninoofse Steenweg / Hoevestraat 
                                        - Oude Heerbaan 
                                        Hoevestraat / Oude Heerbaan 
                                          
                                        Alle vaste en mobiele verkeersinfrastructuur op het parcours dient beschermd/verwijderd te worden. 
                                        Alle betrokken verkeerssignalisatie dient tevens afgedekt/verwijderd te worden. 
                                          
                                     
                                     
                                         
                                            Artikel 2 - De signalisatie zal worden aangeleverd door de gemeentediensten volgens het voorstel van de lokale politiezone Pajottenland, overeenkomstig de wettelijke voorschriften. 
                                         
                                        Artikel 3 - Te voorzien door de organisatoren: 
                                         
                                             De bewoners langsheen de straten waar er verkeersmaatregelen worden ingevoerd, moeten minstens 48 uur op voorhand schriftelijk op de hoogte worden gebracht van het evenement en van de verkeersmaatregelen.  
                                             Alle tijdelijk voorziene verkeersborden en hekkens dienen door de organisatoren volgens het voorstel van de Lokale Politiezone Pajottenland, overeenkomstig de wettelijke voorschriften voor het evenement geplaatst en onmiddellijk na het evenement te worden verwijderd of afgedekt.  
                                         
                                     
                                 
                            """ ;
    prov:wasGeneratedBy <https://pajottegem-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/cbdc789f-3513-4c65-a10e-133f5a74d91f> .


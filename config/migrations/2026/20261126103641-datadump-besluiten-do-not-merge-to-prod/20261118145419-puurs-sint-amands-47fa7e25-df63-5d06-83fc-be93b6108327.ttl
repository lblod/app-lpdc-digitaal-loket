<https://puurs-sint-amands-echo.cipalschaubroeck.be/id/besluiten/a4f8ca7d-9052-49aa-bb2f-4c5a79cd415f> a ns3:Besluit,
        <https://data.vlaanderen.be/id/concept/BesluitType/ba5922c9-cfad-4b2e-b203-36479219ba56> ;

<https://pajottegem-echo.cipalschaubroeck.be/id/besluiten/5157f243-4410-4746-a46b-451bf31060e2> a ns1:Besluit,
        <https://data.vlaanderen.be/id/concept/BesluitType/256bd04a-b74b-4f2a-8f5d-14dda4765af9> ;
    ns3:description """ 
                                                    Het college keurt de politieverordening met tijdelijke verkeersmaatregelen voor het Buurtfeest Mgr. Abbeloosstraat op zaterdag 24 mei 2025 goed. 
                                                """ ;
    ns3:language <http://publications.europa.eu/resource/authority/language/NLD> ;
    ns3:passed_by <http://data.lblod.info/id/bestuursorganen/1cd382ca-87a9-4693-8216-a4e5e16af3fa> ;
    ns3:title "Politieverordening: Buurtfeest - zaterdag 24 mei 2025" ;
    ns1:motivering """ 
                            """@nl ;
    ns2:uuid "7b7dafab-afef-5a3f-9f24-0aa5d2283d75" ;
    prov:value """ 
                                 
                                    
                                        Artikel 1 - Ter gelegenheid van Buurtfeest Mgr. Abbeloosstraat op zaterdag 24 mei 2025 worden volgende beperkingsmaatregelen voor het verkeer genomen vanaf van 8u tot 20u:
                                     
                                    
                                         
                                     
                                    
                                        Op de Mgr. Abbeloosstraat geldt:
                                     
                                     
                                        de toegang is verboden in beide richtingen, voor iedere bestuurder, uitgezonderd plaatselijk verkeer. Dit wordt gesignaleerd door:- verkeersborden C3 
                                        Op de Mgr. Abbeloosstraat en de Kerkhofstraat ter afbakening van het kruispunt Mgr. Abbeloosstraat en Kerkhofstraat geldt: 
                                        de toegang is verboden in beide richtingen, voor iedere bestuurder.Dit wordt gesignaleerd door:- verkeersborden C3 
                                        Op het kruispunt Mgr. Abbeloosstraat en de Kerkhofstraat langs de zijde van de grot geldt: 
                                        het stilstaan en parkeren is verboden;  het begin van de parkeerreglementering wordt aangeduid;  de parkeerreglementering geldt over een afstand van meer dan 300 meter. Dit wordt gesignaleerd door:- verkeersborden E3 - de verkeersborden worden aangevuld met x-borden Xa, Xd 
                                     
                                    
                                        Artikel 2 - De signalisatie zal worden aangeleverd door de gemeentediensten volgens het voorstel van de lokale politiezone Pajottenland, overeenkomstig de wettelijke voorschriften.
                                     
                                     
                                        Artikel 3 - Te voorzien door de organisatoren: 
                                         
                                             De bewoners langsheen de straten waar er verkeersmaatregelen worden ingevoerd, moeten minstens 48 uur op voorhand schriftelijk op de hoogte worden gebracht van het evenement en van de verkeersmaatregelen.  
                                             Alle tijdelijk voorziene verkeersborden en hekkens dienen door de organisatoren volgens het voorstel van de Lokale Politiezone Pajottenland, overeenkomstig de wettelijke voorschriften voor het evenement geplaatst en onmiddellijk na het evenement te worden verwijderd of afgedekt.  
                                         
                                     
                                 
                            """ ;
    prov:wasGeneratedBy <https://pajottegem-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/5157f243-4410-4746-a46b-451bf31060e2> .


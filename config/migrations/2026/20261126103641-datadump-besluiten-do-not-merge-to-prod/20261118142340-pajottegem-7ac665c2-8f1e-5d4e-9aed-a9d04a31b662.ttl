<https://pajottegem-echo.cipalschaubroeck.be/id/besluiten/ff6b7bf0-d51a-4ea6-9519-4d80712dd19f> a ns1:Besluit,
        <https://data.vlaanderen.be/id/concept/BesluitType/256bd04a-b74b-4f2a-8f5d-14dda4765af9> ;
    ns2:description """ 
                                                    Het college van burgemeester en schepenen keurt de politieverordening met tijdelijke verkeersmaatregelen voor de wielerwedstrijd op 21 augustus 2026 goed. 
                                                """ ;
    ns2:language <http://publications.europa.eu/resource/authority/language/NLD> ;
    ns2:passed_by <http://data.lblod.info/id/bestuursorganen/1cd382ca-87a9-4693-8216-a4e5e16af3fa> ;
    ns2:title "Politieverordening: Renewi Tour 2026 - 21 augustus 2026" ;
    ns1:motivering """ 
                            """@nl ;
    ns3:uuid "7ac665c2-8f1e-5d4e-9aed-a9d04a31b662" ;
    prov:value """ 
                                 
                                    
                                        Artikel 1 - Ter gelegenheid van de wielerwedstrijd op 21 augustus 2026 worden volgende beperkingsmaatregelen voor het verkeer genomen:
                                     
                                    
                                         
                                     
                                    
                                         
                                     
                                    
                                        Stilstaan- en parkeerverbod (fig E3) wordt ingelast op 20-08-2026 16.00 uur tot 21-08-2026 17.30 uur in volgende straat:
                                     
                                     
                                         
                                            HeirbaanStilstaan en parkeren verboden (fig E3) op de Heirbaan vanaf de Kapellestraat (grondgebied Geraardsbergen) tot het kruispunt met de Bruinsbroekstraat (parkeerstrook rechts richting Waarbeke). 
                                         
                                        
                                             
                                         
                                     
                                     
                                        Stilstaan- en parkeerverbod (fig E3) wordt ingelast op 21-08-2026 van 13.30 uur tot 17.30 uur in volgende straten: 
                                         
                                            HeirbaanStilstaan en parkeren verboden (fig E3) op de Heirbaan vanaf de Bruinsbroekstraat tot de Meidries (grondgebied Geraardsbergen). 
                                            BruinsbroekstraatStilstaan en parkeren verboden (fig E3) op de Bruinsbroekstraat vanaf het kruispunt met de Waterschaapstraat tot het kruispunt met de Heirbaan. 
                                         
                                        
                                             
                                         
                                        
                                             
                                         
                                        Eénrichtingsverkeer (fig C1 + fig F19) wordt ingelast op 21-08-2026 van 14.30 uur tot 17.30 uur in volgende straat: 
                                         
                                            BruinsbroekstraatVerboden richting voor ieder bestuurder (fig C1) op de Bruinsbroekstraat vanaf het kruispunt met de Waterschaapstraat (verkeersbord + nadar!) tot het kruispunt met de Heirbaan. 
                                         
                                        
                                             
                                         
                                        
                                             
                                         
                                        Verbod aan het volgend kruispunt af te slaan in de richting door de pijl aangegeven (fig C31a / fig C31b) wordt ingelast op 21-08-2026 van 14.30 uur tot 17.30 uur op volgende kruispunten: 
                                         
                                            Bruinsbroekstraat 
                                             
                                                Noremansberg / Bruinsbroekstraat 
                                                Waterschaapstraat / Bruinbroekstraat 
                                             
                                         
                                        
                                             
                                         
                                        NadarsNadars op de Heirbaan vanaf de top van de Bosberg (kruispunt Noremansberg inbegrepen) tot het kruispunt met de Bruinsbroekstraat. Deze dienen geplaatst te worden op de dag van de wedstrijd voor 12.00 uur, de nodige afspraken in verband met de plaatsing dienen gemaakt te worden tussen de organisator en de gemeente Pajottegem.Indien deze nadars niet geplaatst worden is het onmogelijk om de supporters van de rijbaan te houden en een veilige doortocht te garanderen! 
                                     
                                    
                                         
                                     
                                    
                                         
                                     
                                     
                                         
                                            Artikel 2 - De signalisatie zal worden aangeleverd door de gemeentediensten volgens het voorstel van de lokale politiezone Pajottenland, overeenkomstig de wettelijke voorschriften. 
                                             
                                             
                                         
                                        Artikel 3 - Te voorzien door de organisatoren: 
                                         
                                             De bewoners langsheen de straten waar er verkeersmaatregelen worden ingevoerd, moeten minstens 48 uur op voorhand schriftelijk op de hoogte worden gebracht van het evenement en van de verkeersmaatregelen.  
                                             Alle tijdelijk voorziene verkeersborden en hekkens dienen door de organisatoren volgens het voorstel van de Lokale Politiezone Pajottenland, overeenkomstig de wettelijke voorschriften voor het evenement geplaatst en onmiddellijk na het evenement te worden verwijderd of afgedekt.  
                                         
                                     
                                 
                            """ ;
    prov:wasGeneratedBy <https://pajottegem-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/ff6b7bf0-d51a-4ea6-9519-4d80712dd19f> .


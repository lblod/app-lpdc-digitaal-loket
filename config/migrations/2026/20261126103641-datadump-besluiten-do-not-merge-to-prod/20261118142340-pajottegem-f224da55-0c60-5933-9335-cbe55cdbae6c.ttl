<https://pajottegem-echo.cipalschaubroeck.be/id/besluiten/3c860352-7fe5-4928-872d-85b6a4d90028> a ns1:Besluit,
        <https://data.vlaanderen.be/id/concept/BesluitType/256bd04a-b74b-4f2a-8f5d-14dda4765af9> ;
    ns3:description """ 
                                                    Het college keurt de politieverordening met tijdelijke verkeersmaatregelen voor het verjaardagsfeest op 9/08 t.e.m. 10/08 goed. 
                                                """ ;
    ns3:language <http://publications.europa.eu/resource/authority/language/NLD> ;
    ns3:passed_by <http://data.lblod.info/id/bestuursorganen/1cd382ca-87a9-4693-8216-a4e5e16af3fa> ;
    ns3:title "Politieverordening: Verjaardag DJ Mars - 9/08 t.e.m. 10/08 " ;
    ns1:motivering """ 
                            """@nl ;
    ns2:uuid "f224da55-0c60-5933-9335-cbe55cdbae6c" ;
    prov:value """ 
                                 
                                    
                                        Artikel 1 - Ter gelegenheid van verjaardagsfeest op 9/08 t.e.m. 10/08 worden volgende beperkingsmaatregelen voor het verkeer genomen:
                                     
                                    
                                         
                                     
                                     
                                         
                                            Verboden stil te staan en te parkeren (E3) op 8 parkeerplaatsen t.h.v. JH GUUK met geldigheid 9/08 12u t.e.m. 18u 
                                         
                                     
                                    
                                         
                                     
                                    
                                         
                                     
                                     
                                         
                                            Artikel 2 - De signalisatie zal worden aangeleverd door de gemeentediensten overeenkomstig de wettelijke voorschriften. 
                                         
                                        Artikel 3 - Te voorzien door de organisatoren: 
                                         
                                             De bewoners langsheen de straten waar er verkeersmaatregelen worden ingevoerd, moeten minstens 48 uur op voorhand schriftelijk op de hoogte worden gebracht van het evenement en van de verkeersmaatregelen.  
                                             Alle tijdelijk voorziene verkeersborden en hekkens dienen door de organisatoren overeenkomstig de wettelijke voorschriften voor het evenement geplaatst en onmiddellijk na het evenement te worden verwijderd of afgedekt.  
                                         
                                     
                                 
                            """ ;
    prov:wasGeneratedBy <https://pajottegem-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/3c860352-7fe5-4928-872d-85b6a4d90028> .


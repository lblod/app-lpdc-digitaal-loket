<https://brakel-echo.cipalschaubroeck.be/id/besluiten/2520d3dd-7478-4a6e-aa97-d05b711a7154> a ns1:Besluit,
        <https://data.vlaanderen.be/id/concept/BesluitType/e96ec8af-6480-4b32-876a-fefe5f0a3793> ;
    ns3:language <http://publications.europa.eu/resource/authority/language/NLD> ;
    ns3:passed_by <http://data.lblod.info/id/bestuursorganen/59b1dacf1caa0dd64b2a30cb8cea4c20ec24ea245289789b3dcb24ecb4e272c8> ;
    ns3:title "Gebouwen. Basisschool en kleuterschool. Vervangen asbestdaken. Gunning bij hoogdringendheid. Kennisname." ;
    ns1:motivering """ 
                                                                 
                                                                    Regelgeving en bevoegdheid 
                                                                    Het Bestuursdecreet van 7 december 2018. 
                                                                    Het Decreet Lokaal Bestuur van 22 december 2017, meer bepaald artikels 326 tot en met 341 betreffende het bestuurlijk toezicht. 
                                                                    Het Decreet Lokaal Bestuur van 22 december 2017, meer bepaald artikel 56, § 3, 5°, waarbij wordt bepaald dat het college van burgemeester en schepenen bevoegd is voor de vaststelling van de plaatsingsprocedure en de voorwaarden van overheidsopdrachten al het gaat om een opdracht van dagelijks bestuur. 
                                                                    Het Decreet Lokaal Bestuur van 22 december 2017; meer bepaald artikel 269. 
                                                                    Het besluit van de gemeenteraad van 01 januari 2019 houdende vaststelling van de opdrachten voor werken, leveringen en diensten die kunnen beschouwd worden als opdrachten van dagelijks bestuur. 
                                                                 
                                                                 
                                                                    Feiten, context en argumentatie 
                                                                    Vanaf maandag 31 maart 2025 kunnen scholen via OVAM een aanvraag indienen voor een tussenkomst voor asbestverwijderingen in schoolgebouwen in het kader van het sectorprotocol voor asbestveilige scholen. 100% tussenkomst in de kosten voor asbestverwijdering. Deadline indienen subsidieaanvraag: 25 mei 2025.  
                                                                    Goedkeuring lastvoorwaarden en gunningswijze door het college van burgemeester en schepenen in de zitting van 7 april 2025. 
                                                                    Het besluit van het schepencollege van 19 mei 2025 houdende de goedkeuring van de offerte van Dakwerken Bart Rousseau, Toepkapelstraat 5 te 9660 Brakel, ten bedrage van € 126.543,25 excl. 6% btw of € 134.135,85 incl. 6% btw voor het vervangen van de asbestdaken in de gemeentelijke basisschool en de kleuterschool. 
                                                                 
                                                            """@nl ;
    ns2:uuid "f7173d98-6b69-56f9-9ea0-983eb5436a9d" ;
    prov:value """ 
                                                                 
                                                                    Besluit 
                                                                    Artikel 1 : De gemeenteraad neemt kennis van het besluit van het college d.d. 19 mei 2025 betreffende het vervangen van de asbestdaken in de gemeentelijke basisschool en de kleuterschool door de firma Dakwerken Bart Rousseau, Toepkapelstraat 5 te 9660 Brakel. 
                                                                    Artikel 2 : Afschrift van onderhavige beslissing wordt overgemaakt aan de financieel directeur en aan de financiële dienst van onze gemeente. 
                                                                 
                                                            """ ;
    prov:wasGeneratedBy <https://brakel-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/2520d3dd-7478-4a6e-aa97-d05b711a7154> .


<https://pajottegem-echo.cipalschaubroeck.be/id/besluiten/db5ebefc-1246-48fa-9747-850d7e3235d3> a ns2:Besluit,
        <https://data.vlaanderen.be/id/concept/BesluitType/256bd04a-b74b-4f2a-8f5d-14dda4765af9> ;
    ns3:description """ 
                                                    Het college keurt de politieverordening met tijdelijke verkeersmaatregelen voor de Lokale wielerwedstrijd - Open Omloop - Elite 2 op 16 juni 2025 goed. 
                                                """ ;
    ns3:language <http://publications.europa.eu/resource/authority/language/NLD> ;
    ns3:passed_by <http://data.lblod.info/id/bestuursorganen/1cd382ca-87a9-4693-8216-a4e5e16af3fa> ;
    ns3:title "Politieverordening: G.P. Rene Deridder - 16 juni 2025" ;
    ns2:motivering """ 
                            """@nl ;
    ns1:uuid "54699cca-692a-55f6-8b39-51e786cd2d60" ;
    prov:value """ 
                                 
                                    
                                        Artikel 1 - Ter gelegenheid van Lokale wielerwedstrijd - Open Omloop - Elite 2 op 16 juni 2025 worden volgende beperkingsmaatregelen voor het verkeer genomen:
                                     
                                    
                                         
                                     
                                    
                                        Stilstaan- en parkeerverbod (fig E3) wordt ingelast van 08.00 uur tot 19.00 uur in volgende straten:
                                     
                                     
                                        - Bruneaustraat 
                                        Stilstaan en parkeren verboden (fig E3) op de Bruneaustraat vanaf het kruispunt met de Oude Molenstraat (N272) tot het kruispunt met de Edingsesteenweg (N285) (vertrek- en aankomstzone). 
                                          
                                        Stilstaan- en parkeerverbod (fig E3) wordt ingelast van 13.00 uur tot 18.00 uur in volgende straten: 
                                        - Edingsesteenweg (N285) 
                                        Stilstaan en parkeren verboden (fig E3) op de Edingsesteenweg (N285) vanaf het kruispunt met de Bruneaustraat tot het kruispunt met de Kattestraat. 
                                        - Kattestraat 
                                        Stilstaan en parkeren verboden (fig E3) op de Kattestraat vanaf het kruispunt met de Edingsesteenweg (N285) tot het kruispunt met de Heidestraat. 
                                        - Heidestraat 
                                        Stilstaan en parkeren verboden (fig E3) op de Heidestraat vanaf het kruispunt met de Kattestraat tot het kruispunt met de Kesterweg. 
                                        - Kesterweg 
                                        Stilstaan en parkeren verboden (fig E3) op de Kesterweg vanaf het kruispunt met de Heidestraat tot het kruispunt met de Vierbergenstraat. 
                                        - Vierbergenstraat 
                                        Stilstaan en parkeren verboden (fig E3) op de Vierbergenstraat vanaf het kruispunt met de Kesterweg tot het kruispunt met de Goteringenstraat. 
                                        - Goteringenstraat 
                                        Stilstaan en parkeren verboden (fig E3) op de Goteringenstraat vanaf het kruispunt met de Vierbergenstraat tot het kruispunt met de Langestraat (N272). 
                                        - Langestraat (N272) 
                                        Stilstaan en parkeren verboden (fig E3) op de Langestraat (N272) vanaf het kruispunt met de Goteringenstraat tot het kruispunt met de Edingsesteenweg (N285). 
                                        - Bruneaustraat (N272) 
                                        Stilstaan en parkeren verboden (fig E3) op de Bruneaustraat (N272) vanaf het kruispunt met de Edingsesteenweg (N285) tot het kruispunt met de Oude Molenstraat (N272). 
                                          
                                        Eénrichtingsverkeer (fig C1 + fig F19) wordt ingelast van 14.00 uur tot 18.00 uur in volgende straten: 
                                        - Bruneaustraat 
                                        Verboden richting voor ieder bestuurder (fig C1) op de Bruneaustraat vanaf het kruispunt met de Edingsesteenweg (N285) tot het kruispunt met de Oude Molenstraat (N272). 
                                        - Kattestraat 
                                        Verboden richting voor ieder bestuurder (fig C1) op de Kattestraat vanaf het kruispunt met de Heidestraat tot het kruispunt met de Edingsesteenweg (N285). 
                                        - Heidestraat 
                                        Verboden richting voor ieder bestuurder (fig C1) op de Heidestraat vanaf het kruispunt met de Kesterweg tot het kruispunt met de Kattestraat. 
                                        - Kesterweg 
                                        Verboden richting voor ieder bestuurder (fig C1) op de Kesterweg vanaf het kruispunt met de Vierbergenstraat tot het kruispunt met de Heidestraat. 
                                        - Vierbergenstraat 
                                        Verboden richting voor ieder bestuurder (fig C1) op de Vierbergenstraat vanaf het kruispunt met de Goteringenstraat tot het kruispunt met de Kesterweg. 
                                        - Goteringenstraat 
                                        Verboden richting voor ieder bestuurder (fig C1) op de Goteringenstraat vanaf het kruispunt met de Langestraat (N272) tot het kruispunt met de Vierbergenstraat. 
                                          
                                        Verbod aan het volgend kruispunt af te slaan in de richting door de pijl aangegeven (fig C31a / fig C31b) wordt ingelast van 14.00 uur tot 18.00 uur op volgende kruispunten: 
                                        - Edingsesteenweg 
                                        Edingsesteenweg / Bruneaustraat 
                                        - Kesterweg 
                                        Kesterweg / Bruneaustraat 
                                        - Heidestraat 
                                        Kesterheide / Heidestraat 
                                        - Kesterweg 
                                        Kesterweg / Heidestraat 
                                        Vierbergenstraat / Kesterweg 
                                        - Vierbergenstraat 
                                        Vierbergenstraat / Kesterweg 
                                        - Warandestraat 
                                        Warandestraat / Vierbergenstraat 
                                        - Berghomstraat 
                                        Berghomstraat / Vierbergenstraat 
                                        - Daalstraat 
                                        Daalstraat / Goteringenstraat 
                                        Daalstraat / Goteringenstraat 
                                        Daalstraat / Goteringenstraat 
                                        - Frankrijkstraat 
                                        Frankrijkstraat / Goteringenstraat 
                                        - Peverstraat 
                                        Peverstraat / Goteringenstraat 
                                        - Goteringenstraat 
                                        Goteringenstraat / Goteringenstraat 
                                        - Langestraat 
                                        Langestraat / Goteringenstraat 
                                          
                                        Doodlopende weg (fig F45) wordt ingelast van 14.00 uur tot 18.00 uur op volgende kruispunten: 
                                        - Kattestraat 
                                        Kattestraat / Kleine Kattestraat 
                                          
                                        Alle vaste en mobiele verkeersinfrastructuur op het parcours dient beschermd/verwijderd te worden. 
                                          
                                        Artikel 2 - De signalisatie zal worden aangeleverd door de gemeentediensten volgens het voorstel van de lokale politiezone Pajottenland, overeenkomstig de wettelijke voorschriften. 
                                     
                                     
                                        Artikel 3 - Te voorzien door de organisatoren: 
                                         
                                             De bewoners langsheen de straten waar er verkeersmaatregelen worden ingevoerd, moeten minstens 48 uur op voorhand schriftelijk op de hoogte worden gebracht van het evenement en van de verkeersmaatregelen.  
                                             Alle tijdelijk voorziene verkeersborden en hekkens dienen door de organisatoren volgens het voorstel van de Lokale Politiezone Pajottenland, overeenkomstig de wettelijke voorschriften voor het evenement geplaatst en onmiddellijk na het evenement te worden verwijderd of afgedekt.  
                                         
                                     
                                 
                            """ ;
    prov:wasGeneratedBy <https://pajottegem-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/db5ebefc-1246-48fa-9747-850d7e3235d3> .


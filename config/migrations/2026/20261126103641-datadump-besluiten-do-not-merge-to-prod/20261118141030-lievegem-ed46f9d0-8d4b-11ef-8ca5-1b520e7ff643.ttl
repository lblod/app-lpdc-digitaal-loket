<https://lievegem-echo.cipalschaubroeck.be/id/besluiten/773db485-658a-4e7b-be39-7eb511439f54> a ns1:Besluit ;
    ns2:description """ 
                                                    De gemeenteraad neemt kennis van de beslissing van de gouverneur van 27 november 2020 tot goedkeuring van de jaarrekening 2019 van de gemeente Lievegem. 
                                                """ ;
    ns2:language <http://publications.europa.eu/resource/authority/language/NLD> ;
    ns2:passed_by <http://data.lblod.info/id/bestuursorganen/15081fa9-4889-4e4d-a7cc-9708549e4847> ;
    ns2:title "Jaarrekening 2019 van de gemeente - besluit van de gouverneur tot goedkeuring: kennisname" ;
    ns1:motivering """ 
                                                         
                                                            Bevoegd lid 
                                                            Kim Martens, schepen 
                                                         
                                                         
                                                            Regelgeving 
                                                            Decreet lokaal bestuur van 22 december 2017, artikel 332, §1, derde lidGemeenteraadsbesluit van 1 juli 2020 over de vaststelling van de jaarrekening 2019 van de gemeenteBesluit van de gouverneur van 27 november 2020 tot goedkeuring van de jaarrekening 2019 van de gemeente Lievegem 
                                                         
                                                         
                                                            Feiten en motivering 
                                                            De gemeenteraad heeft op 1 juli 2020 de jaarrekening 2019 van de gemeente vastgesteld en ter goedkeuring overgemaakt aan de toezichthoudende overheid, zijnde de gouverneur.Het besluit van de gouverneur tot goedkeuring van de jaarrekening wordt ter kennis gebracht op de eerstvolgende vergadering van de gemeenteraad. 
                                                         
                                                    """@nl ;
    ns3:uuid "ed46f9d0-8d4b-11ef-8ca5-1b520e7ff643" ;
    prov:value """ 
                                                         
                                                            Besluit 
                                                            Enig artikel 
                                                            De gemeenteraad neemt kennis van de beslissing van de gouverneur van 27 november 2020 tot goedkeuring van de jaarrekening 2019 van de gemeente Lievegem. 
                                                         
                                                    """ ;
    prov:wasGeneratedBy <https://lievegem-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/773db485-658a-4e7b-be39-7eb511439f54> .


<https://brakel-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/128350ce-cef3-4746-a3fc-94abb96b71cc> a ns2:BehandelingVanAgendapunt ;
    ns2:gebeurtNa <https://brakel-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/8648e2a0-4bcb-471f-96fc-8d9c7700d571> ;

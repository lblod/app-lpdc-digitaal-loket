    dcterms:description """ 
                                                             
                                                                Fietspad N8. Richting Oudenaarde. Addendum nr. 1 aan koepelmodule 45059/4a/13c-13d-17c met module 13 E, 13D - module 17C d.d. 16/12/2003 horende bij de moederconvenant 45059/0 d.d. 02/07/1997, afgesloten met de gemeente Brakel. Stopzetting. 
                                                             
                                                        """ ;
    dcterms:subject <https://brakel-echo.cipalschaubroeck.be/id/agendapunten/3d196578-c957-4887-bc28-793d29ade565> ;

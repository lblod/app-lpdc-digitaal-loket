<https://brakel-echo.cipalschaubroeck.be/id/besluiten/3d196578-c957-4887-bc28-793d29ade565> a ns1:Besluit,
        <https://data.vlaanderen.be/id/concept/BesluitType/e96ec8af-6480-4b32-876a-fefe5f0a3793> ;
    ns2:language <http://publications.europa.eu/resource/authority/language/NLD> ;
    ns2:passed_by <http://data.lblod.info/id/bestuursorganen/59b1dacf1caa0dd64b2a30cb8cea4c20ec24ea245289789b3dcb24ecb4e272c8> ;
    ns2:title "Fietspad N8. Richting Oudenaarde. Addendum nr. 1 aan koepelmodule 45059/4a/13c-13d-17c met module 13 E, 13D -module 17C d.d. 16/12/2003 horende bij de moederconvenant 45059/0 d.d. 02/07/1997, afgesloten met de gemeente Brakel. Stopzetting. Goedkeuring." ;
    ns1:motivering """ 
                                                                 
                                                                    Regelgeving en bevoegdheid 
                                                                    Decreet Lokaal Bestuur van 22 december 2017; 
                                                                 
                                                                 
                                                                    Feiten, context en argumentatie 
                                                                    Gelet op de beslissing van de gemeenteraad d.d. 10 juli 2023 houdende de goedkeuring van de dading met studiebureau Sweco met het oog op stopzetting ontwerpopdracht "Fietspad N8 - Richting Oudenaarde". 
                                                                    Gelet op de koepelmodule 45059/4/13c - 13d - 17c horende bij het moederconvenant 45059/0 d.d. 2/07/1997 met modules 13c, 13d en 17e d.d. 16/12/2003 met de gemeente Brakel; 
                                                                    Voorstel van het college van burgemeester en schepenen om de voormelde koepelmodule stop te zetten. 
                                                                 
                                                            """@nl ;
    ns3:uuid "c024da20-ce79-11ef-9218-6931664218fe" ;
    prov:value """ 
                                                                 
                                                                    Besluit 
                                                                    Artikel 1 : De gemeenteraad keurt de stopzetting goed van de addendum nr. 1 aan koepelmodule 45059/4a/13c-13d-17c met module 13 E, 13D - module 17C d.d. 16/12/2003 horende bij de moederconvenant 45059/0 d.d. 02/07/1997, afgesloten met de gemeente Brakel, ook gekend als " Fietspad N8. Richting Oudenaarde". 
                                                                    Artikel 2 : Afschrift van voormelde beslissing wordt overgemaakt aan Het Vlaamse Gewest en aan onze financiële dienst. 
                                                                 
                                                            """ ;
    prov:wasGeneratedBy <https://brakel-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/3d196578-c957-4887-bc28-793d29ade565> .


<https://brakel-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/8e3e9af8-5e86-4797-982c-05ba884403c3> a ns1:BehandelingVanAgendapunt ;
    ns1:gebeurtNa <https://brakel-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/3e0ff05d-dd75-4947-9eeb-4309746cf8bf> ;
    ns1:openbaar true ;
    ns3:uuid "c326cf80-ce79-11ef-9218-6931664218fe" ;
    dcterms:description """ 
                             
                                De gemeenteraad onderzoekt de geloofsbrieven van de verkozenen. De geloofsbrieven omvatten de bewijsstukken die alle verkozenen die opgeroepen zijn om de eed af te leggen, moeten voorleggen en waaruit blijkt dat ze op een wettige wijze zijn verkozen en er tegen hun verkiezing geen bezwaren zijn. 
                             
                        """,
        """ 
                                                             
                                                                De gemeenteraad onderzoekt de geloofsbrieven van de verkozenen. De geloofsbrieven omvatten de bewijsstukken die alle verkozenen die opgeroepen zijn om de eed af te leggen, moeten voorleggen en waaruit blijkt dat ze op een wettige wijze zijn verkozen en er tegen hun verkiezing geen bezwaren zijn. 
                                                             
                                                        """ ;
    dcterms:subject <https://brakel-echo.cipalschaubroeck.be/id/agendapunten/8e3e9af8-5e86-4797-982c-05ba884403c3> ;
    prov:generated <https://brakel-echo.cipalschaubroeck.be/id/besluiten/8e3e9af8-5e86-4797-982c-05ba884403c3> .

<https://brakel-echo.cipalschaubroeck.be/id/besluiten/8e3e9af8-5e86-4797-982c-05ba884403c3> a ns1:Besluit ;
    ns2:language <http://publications.europa.eu/resource/authority/language/NLD> ;
    ns2:passed_by <http://data.lblod.info/id/bestuursorganen/59b1dacf1caa0dd64b2a30cb8cea4c20ec24ea245289789b3dcb24ecb4e272c8> ;
    ns2:title "Installatie gemeenteraadslid." ;
    ns1:motivering """ 
                                 
                                    Regelgeving en bevoegdheid 
                                    Decreet over het lokaal bestuur, artikel 6, 9, 10, 11, 14  
                                    Het lokaal en provinciaal kiesdecreet van 8 juli 2011, artikel, 8, 11, 58 ,169 
                                    Decreet over het lokaal bestuur, artikel 6, 8, 9, 10, 11, 14 
                                    Omzendbrief KBBABB 2024/2 over de start van de lokale en provinciale bestuursperiode 
                                 
                                 
                                    Feiten, context en argumentatie 
                                    De gemeenteraad onderzoekt de geloofsbrieven van de verkozenen. De gemeenteraad gaat na of de verkozenen nog voldoen aan de verkiesbaarheidsvoorwaarden en zij zich niet bevinden in een situatie van onverenigbaarheid. 
                                 
                            """@nl,
        """ 
                                                                 
                                                                    Regelgeving en bevoegdheid 
                                                                    Decreet over het lokaal bestuur, artikel 6, 9, 10, 11, 14  
                                                                    Het lokaal en provinciaal kiesdecreet van 8 juli 2011, artikel, 8, 11, 58 ,169 
                                                                    Decreet over het lokaal bestuur, artikel 6, 8, 9, 10, 11, 14 
                                                                    Omzendbrief KBBABB 2024/2 over de start van de lokale en provinciale bestuursperiode 
                                                                 
                                                                 
                                                                    Feiten, context en argumentatie 
                                                                    De gemeenteraad onderzoekt de geloofsbrieven van de verkozenen. De gemeenteraad gaat na of de verkozenen nog voldoen aan de verkiesbaarheidsvoorwaarden en zij zich niet bevinden in een situatie van onverenigbaarheid. 
                                                                 
                                                            """@nl ;
    ns3:uuid "c3296790-ce79-11ef-9218-6931664218fe" ;
    prov:value """ 
                                 
                                    Besluit 
                                    De gemeenteraad neemt kennis van de eedaflegging van mevrouw Marleen Gyselinck. 
                                 
                            """,

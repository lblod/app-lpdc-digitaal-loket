<https://brakel-echo.cipalschaubroeck.be/id/besluiten/e6f0060e-4b07-43a1-a36a-2bfecc36576b> a ns1:Besluit,
        <https://data.vlaanderen.be/id/concept/BesluitType/79414af4-4f57-4ca3-aaa4-f8f1e015e71c> ;

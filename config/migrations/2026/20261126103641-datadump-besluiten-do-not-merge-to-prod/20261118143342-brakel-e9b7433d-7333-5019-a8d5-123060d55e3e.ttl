        """ 
                                                             
                                                                Op 08 maart 2025 ontving de gemeente Brakel de jaarrekening 2024 van de kerkfabriek Sint-Apollonia - deelgemeente Elst. 
                                                             
                                                        """ ;
    dcterms:subject <https://brakel-echo.cipalschaubroeck.be/id/agendapunten/e6f0060e-4b07-43a1-a36a-2bfecc36576b> ;

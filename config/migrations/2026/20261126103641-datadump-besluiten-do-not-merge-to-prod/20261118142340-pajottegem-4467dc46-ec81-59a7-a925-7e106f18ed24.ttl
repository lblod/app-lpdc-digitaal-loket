    ns2:description """ 
                                                    Het college keurt de politieverordening met tijdelijke verkeersmaatregelen voor de Processie Kester op 31 mei 2026 goed. 
                                                """ ;
    ns2:language <http://publications.europa.eu/resource/authority/language/NLD> ;
    ns2:passed_by <http://data.lblod.info/id/bestuursorganen/1cd382ca-87a9-4693-8216-a4e5e16af3fa> ;
    ns2:title "Politieverordening: Processie Kester - 31 mei 2026" ;
    ns1:motivering """ 
                            """@nl ;
    ns3:uuid "4467dc46-ec81-59a7-a925-7e106f18ed24" ;
    prov:value """ 
                                 
                                    
                                         
                                     
                                    
                                        Artikel 1 - Ter gelegenheid van Processie Kester worden volgende beperkingsmaatregelen voor het verkeer genomen:
                                     
                                    
                                         
                                     
                                    
                                         
                                     
                                    
                                        31 mei 2026 vanaf 6u30 tot 9u:
                                     
                                    
                                         
                                     
                                     
                                         
                                            Verboden stil te staan en te parkeren (Fig. E3) op de Sint-Niklaasstraat, langs beide zijden van de rijweg 
                                         
                                     
                                    
                                        31 mei 2026 vanaf 8u30 tot 11u:
                                        
                                        
                                     
                                     
                                         
                                            Verboden stil te staan en te parkeren (Fig. E3) op het Kerkplein te Oetingen 
                                         
                                     
                                    
                                        31 mei 2026 vanaf 5u tot 15u:
                                     
                                    
                                         
                                     
                                     
                                         
                                            Verboden stil te staan en te parkeren (Fig. E3) op volgende locaties: 
                                             
                                                Oude Molenstraat (N272) 
                                                Kerkhof Kester 
                                                Edingsesteenweg; vanaf het kruispunt met de Bruneaustraat tot het kruispunt met de Kesterweg (beide richtingen) 
                                                Kesterweg; vanaf het kruispunt met de Edingsesteenweg tot het kruispunt met de Kesterweg (beide richtingen) 
                                                Bruneaustraat; vanaf het kruispunt met de Edingsesteenweg tot het kruispunt met de Oude Molenstraat straat (beide richtingen) 
                                                Bruneaustraat; langs huisnr. 74-80A (rechterzijde plein, voor de kerk) 
                                                Lenniksestraat; tussen huisnr. 81 en 87 
                                             
                                            Verplicht parkeren op het voetpad (Fig. E9a) op Oude Molenstraat (N272) tussen beide zijstraten Raoul Merckxstraat langs zijde van de pare huisnummers 
                                         
                                        
                                             
                                         
                                     
                                    
                                        31 mei 2026 vanaf 8u30 tot 11u:
                                     
                                    
                                        
                                     
                                     
                                         
                                            Verboden stil te staan en te parkeren (Fig. E3) op volgende locaties:  
                                             
                                                Kerkstraat; tussen Warandestraat en Kerkplein (beide richtingen) 
                                                Vollezelestraat; tussen Kerkplein en Kloosterstraat (beide richtingen) 
                                                Lenniksestraat; tussen Oude Heerbaan en Warandestraat (beide richtingen) 
                                             
                                         
                                     
                                    
                                        29 mei 2026 vanaf 8u tot 2 juni 2026 om 16u:
                                     
                                    
                                         
                                     
                                     
                                         
                                            Verboden stil te staan en te parkeren op Patattestraat t.h.v. huisnr. 2-4 
                                         
                                     
                                    
                                        30 mei 2026 vanaf 6u tot 15u:
                                     
                                    
                                         
                                     
                                     
                                         
                                            Verboden toegang, in beide richtingen, voor iedere bestuurder (Fig. C3) op Bruneaustraat; vanaf het kruispunt met de Kesterweg tot het kruispunt met de Patattestraat 
                                         
                                     
                                    
                                        30 mei 2026 vanaf 10u tot 12u:
                                        
                                        
                                     
                                     
                                         
                                            Eénrichtingsverkeer (Fig. C1 + fig. F19) op Kesterweg, verboden rijrichting vanaf het kruispunt met Edingseseenweg (N285) tot het kruispunt met de Vierbergenstraat 
                                            Snelheidsverlaging (Fig. C43) naar 50 km/u op de Edingsesteenweg tussen Utveldstraat en de Bruneaustraat (N272) 
                                            Snelheidsverlaging (Fig. C43) naar 30 km/u op de Edingsesteenweg tussen de Bruneaustraat en Kesterweg 
                                         
                                     
                                    
                                         
                                     
                                    
                                         
                                     
                                    
                                         
                                     
                                     
                                         
                                            Artikel 2 - De signalisatie zal worden geleverd en geplaatst door de gemeentediensten overeenkomstig de wettelijke voorschriften. 
                                         
                                        Artikel 3 - Te voorzien door de organisatoren: 
                                         
                                             De bewoners langsheen de straten waar er verkeersmaatregelen worden ingevoerd, moeten minstens 48 uur op voorhand schriftelijk op de hoogte worden gebracht van het evenement en van de verkeersmaatregelen  
                                         
                                     
                                 
                            """ ;

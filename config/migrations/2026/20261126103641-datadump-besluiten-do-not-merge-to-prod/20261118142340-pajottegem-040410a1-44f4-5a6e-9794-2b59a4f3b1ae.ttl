<https://pajottegem-echo.cipalschaubroeck.be/id/besluiten/77348598-5cde-4671-892a-5d4a99530213> a ns2:Besluit,
        <https://data.vlaanderen.be/id/concept/BesluitType/256bd04a-b74b-4f2a-8f5d-14dda4765af9> ;
    ns1:description """ 
                                                    Het college keurt de politieverordening met tijdelijke verkeersmaatregelen voor de Voorstelling op zaterdag 5 en zondag 6 april goed. 
                                                """ ;
    ns1:language <http://publications.europa.eu/resource/authority/language/NLD> ;
    ns1:passed_by <http://data.lblod.info/id/bestuursorganen/1cd382ca-87a9-4693-8216-a4e5e16af3fa> ;
    ns1:title "Politieverordening: ",
        "Politieverordening: \"Marleen heeft de groep verlaten\" - zaterdag 5 en zondag 6 april" ;
    ns2:motivering """ 
                            """@nl ;
    ns3:uuid "040410a1-44f4-5a6e-9794-2b59a4f3b1ae" ;
    prov:value """ 
                                 
                                    
                                         
                                     
                                    
                                        Artikel 1 - Ter gelegenheid van een voorstelling op zaterdag 5 en zondag 6 april worden volgende beperkingsmaatregelen voor het verkeer genomen tussen 10u en 22u:
                                     
                                    
                                         
                                     
                                    
                                        Afsluiten van de rijweg (nader + C3 + type IV 'uitgezonderd plaatselijk verkeer) op volgende straten:
                                     
                                    
                                         
                                     
                                    
                                         Hazelaarswijk t.h.v. huisnummer 31
                                     
                                    
                                         
                                     
                                     
                                         
                                            Artikel 2 - De signalisatie zal worden aangeleverd door de gemeentediensten volgens het voorstel, overeenkomstig de wettelijke voorschriften. 
                                         
                                        Artikel 3 - Te voorzien door de organisatoren: 
                                         
                                             De bewoners langsheen de straten waar er verkeersmaatregelen worden ingevoerd, moeten minstens 48 uur op voorhand schriftelijk op de hoogte worden gebracht van het evenement en van de verkeersmaatregelen.  
                                             Alle tijdelijk voorziene verkeersborden en hekkens dienen door de organisatoren, overeenkomstig de wettelijke voorschriften voor het evenement geplaatst en onmiddellijk na het evenement te worden verwijderd of afgedekt.  
                                         
                                     
                                 
                            """ ;
    prov:wasGeneratedBy <https://pajottegem-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/77348598-5cde-4671-892a-5d4a99530213> .


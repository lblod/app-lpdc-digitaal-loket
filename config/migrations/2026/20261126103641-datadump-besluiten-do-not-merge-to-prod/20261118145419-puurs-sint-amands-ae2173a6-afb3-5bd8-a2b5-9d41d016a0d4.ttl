    ns1:passed_by <http://data.lblod.info/id/bestuursorganen/2e5c95ecec50764ebb1b6b35d655a246117522a7e6c0e118a88766874dd78acb> ;
    ns1:title "Tarieven retributiereglement voor gebruik van bibliotheek - Vaststelling" ;
    ns2:motivering """ 
                                 
                                    Aanleiding 
                                    De gemeenteraad heeft in vergadering van 24 november 2025 het retributiereglement van het gebruik van de bibliotheek vastgesteld.  
                                 
                                 
                                    Juridische grond 
                                     
                                         
                                            Volgende bevoegdheidsgrond en regelgeving is van toepassing:  
                                         
                                         
                                            Bevoegdheidsgrond  
                                         
                                         
                                            Het Decreet over het lokaal bestuur van 22 december 2017, artikelen 56 en 177; 
                                         
                                     
                                     
                                         
                                            Toepasselijke regelgeving  
                                         
                                         
                                            De omzendbrief KB/ABB 2019/2 van 15 februari 2019 betreffende de gemeentefiscaliteit; 
                                            De gemeenteraadsbeslissing van 24 november 2025 m.b.t. de vaststelling van het retributiereglement van het gebruik van de bibliotheek; 
                                         
                                     
                                 
                                 
                                    Feiten, context en argumentatie 
                                    De gemeenteraad heeft in vergadering van 24 november 2025 het retributiereglement voor het gebruik van de bibliotheek vastgesteld. Artikel 8 van dit retributiereglement voorziet dat het college van burgemeester en schepenen gemachtigd is om de tarieven van de retributies vast te stellen. De argumentatie tot differentiatie in de tarieven is opgenomen in het besluit van de gemeenteraad. 
                                    Aan het college van burgemeester en schepenen wordt gevraagd de tarieven vast te stellen met ingang van 1 januari 2026.  
                                 
                                 
                                    Financiële weerslag 
                                    De inkomsten zijn opgenomen in het meerjarenplan onder budgetsleutel 0703-00/70081000 en 0703-00/70300100.  
                                 
                            """@nl ;
    ns3:uuid "ae2173a6-afb3-5bd8-a2b5-9d41d016a0d4" ;
    prov:value """ 
                                 
                                    Besluit 
                                    Enig artikel: Het college van burgemeester en schepenen stelt de tarieven van het retributiereglement voor het gebruik van de bibliotheek vast: 
                                    Artikel 1: Opheffing 
                                    Het besluit van het college van burgemeester en schepenen van 6 september 2021 van Puurs-Sint-Amands met betrekking tot de vaststelling van de tarieven voor het gebruik van de bibliotheek, wordt opgeheven met ingang van 1 januari 2026.  
                                    Artikel 2: Tarieven  
                                    Voor een termijn van 1 januari 2026 tot en met 31 december 2031 worden de retributies voor het gebruik van de bibliotheek als volgt vastgesteld:  
                                    2.1.Lidmaatschap:  
                                     
                                         
                                             
                                                  

<https://brakel-echo.cipalschaubroeck.be/id/besluiten/3a5be618-36f2-499e-8277-3b5f62c98b6d> a ns1:Besluit,
        <https://data.vlaanderen.be/id/concept/BesluitType/e96ec8af-6480-4b32-876a-fefe5f0a3793> ;
    ns3:language <http://publications.europa.eu/resource/authority/language/NLD> ;
    ns3:passed_by <http://data.lblod.info/id/bestuursorganen/59b1dacf1caa0dd64b2a30cb8cea4c20ec24ea245289789b3dcb24ecb4e272c8> ;
    ns3:title "Samenwerkingsverbanden OFP Prolocus. Voordracht gemeentelijke vertegenwoordiger voor de algemene vergaderingen van OFP Prolocus." ;
    ns1:motivering """ 
                                                                 
                                                                    Regelgeving en bevoegdheid 
                                                                    Het  Decreet lokaal bestuur van 22 december 2017, deel 3. 
                                                                 
                                                                 
                                                                    Feiten, context en argumentatie 
                                                                    -Het feit dat de gemeente Brakel lid is aangesloten bij OFP Prolocus 
                                                                    -De statuten van OFP Prolocus 
                                                                     
                                                                      
                                                                    -De vraag vanwege OFP Prolocus om een effectieve en plaatsvervangende vertegenwoordiger aan te duiden voor de algemene vergaderingen van OFP Prolocus. 
                                                                    -Het college van burgemeester en schepenen d.d. 17 maart 2025 nam kennis van de vraag vanwege OFP Prolocus om een effectieve en plaatsvervangende vertegenwoordiger aan te duiden voor de algemene vergaderingen van OFP Prolocus. 
                                                                 
                                                            """@nl ;
    ns2:uuid "c78e4827-4147-5af9-ae71-2a561c8c3967" ;
    prov:value """ 
                                                                 
                                                                    Besluit 
                                                                    Artikel 1: De gemeenteraad beslist om de heer Jan Haegeman, wonende Langakkerstraat 3 te 9660 Brakel (jan.haegeman@brakel.be) aan te duiden als vertegenwoordiger voor de gemeente Brakel in de algemene vergaderingen van OFP Prolocus. 
                                                                    Artikel 2: De gemeenteraad beslist om mevrouw Anouk Vandenhaute, wonende Bergstraat 8 te 9660 Brakel (anouk.vandenhaute@brakel.be) aan te duiden als plaatsvervangend vertegenwoordiger voor de gemeente Brakel in de algemene vergaderingen van OFP Prolocus. 
                                                                    Artikel 3: Indien de gemeenteraad dit besluit niet herroept, blijft het geldig tot de eerstvolgende algehele vernieuwing van de gemeenteraad. 
                                                                    Artikel 4: Een afschrift van deze beslissing zal worden overgemaakt aan de organisatie via het mailadres: info@ofpprolocus.be 
                                                                 
                                                            """ ;
    prov:wasGeneratedBy <https://brakel-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/3a5be618-36f2-499e-8277-3b5f62c98b6d> .


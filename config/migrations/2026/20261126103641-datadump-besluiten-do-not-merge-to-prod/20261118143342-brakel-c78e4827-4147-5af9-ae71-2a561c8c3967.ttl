    dcterms:description """ 
                                                             
                                                                De vraag vanwege OFP Prolocus om een effectieve en plaatsvervangende vertegenwoordiger aan te duiden voor de algemene vergaderingen van OFP Prolocus. 
                                                             
                                                        """ ;
    dcterms:subject <https://brakel-echo.cipalschaubroeck.be/id/agendapunten/3a5be618-36f2-499e-8277-3b5f62c98b6d> ;

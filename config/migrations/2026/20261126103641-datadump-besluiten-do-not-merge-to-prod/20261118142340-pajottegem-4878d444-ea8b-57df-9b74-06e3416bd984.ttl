<https://pajottegem-echo.cipalschaubroeck.be/id/besluiten/2b9f5fe1-ffa5-432a-abdf-2704935c273d> a ns2:Besluit,
        <https://data.vlaanderen.be/id/concept/BesluitType/256bd04a-b74b-4f2a-8f5d-14dda4765af9> ;
    ns3:description """ 
                                                    Het college keurt de politieverordening met tijdelijke verkeersmaatregelen voor de Sportevenement op 17 augustus 2025 goed. 
                                                """ ;
    ns3:language <http://publications.europa.eu/resource/authority/language/NLD> ;
    ns3:passed_by <http://data.lblod.info/id/bestuursorganen/1cd382ca-87a9-4693-8216-a4e5e16af3fa> ;
    ns3:title "Politieverordening: Brillanttochten - 17 augustus 2025" ;
    ns2:motivering """ 
                            """@nl ;
    ns1:uuid "4878d444-ea8b-57df-9b74-06e3416bd984" ;
    prov:value """ 
                                 
                                    
                                        Artikel 1 - Ter gelegenheid van een sportevenement op 17 augustus 2025 worden volgende beperkingsmaatregelen voor het verkeer genomen vanaf 6.00 uur tot en met 18.00 uur:
                                     
                                    
                                         
                                     
                                    
                                        Op de Steenstraat vanaf het kruispunt met de Hulstraat in de richting van de Bakkerstraat geldt:
                                     
                                    
                                        verboden rijrichting voor iedere bestuurder
                                     
                                    
                                        In de tegenovergestelde richting geldt:
                                     
                                    
                                        toegelaten rijrichting op de openbare weg met éénrichtingsverkeer
                                     
                                    
                                        Dit wordt gesignaleerd door:
                                         
                                         
                                            verkeersborden C1 
                                            verkeersborden F19 
                                         
                                     
                                     
                                        
                                            Op de Coppenslaan ter hoogte van kruispunt met de Steenstraat geldt:
                                         
                                         
                                            
                                                Op de Steenstraat ter hoogte van kruispunt met de Hulstraat geldt:
                                             
                                         
                                        
                                            verboden links af te slaan
                                         
                                        
                                            Dit wordt gesignaleerd door:
                                         
                                         
                                             
                                                verkeersborden C31a 
                                             
                                            
                                                Op de Repekouter ter hoogte van het kruispunt met de Steenstraat geldt:
                                             
                                         
                                        
                                            verboden rechts af te slaan
                                         
                                        
                                            Dit wordt gesignaleerd door:
                                         
                                         
                                             
                                                verkeersborden C31b 
                                             
                                         
                                        
                                             
                                         
                                        
                                            Lokale omleiding via Vollezeelsesteenweg - Oudstrijdersplein
                                         
                                        
                                            Dit wordt gesignaleerd door:
                                         
                                         
                                             
                                                verkeersborden F41 
                                             
                                         
                                     
                                    
                                         
                                     
                                     
                                         
                                            Artikel 2 - De signalisatie zal worden aangeleverd door de gemeentediensten volgens het voorstel van de lokale politiezone Pajottenland, overeenkomstig de wettelijke voorschriften. 
                                             
                                         
                                        Artikel 3 - Te voorzien door de organisatoren: 
                                         
                                             De bewoners langsheen de straten waar er verkeersmaatregelen worden ingevoerd, moeten minstens 48 uur op voorhand schriftelijk op de hoogte worden gebracht van het evenement en van de verkeersmaatregelen.  
                                             Alle tijdelijk voorziene verkeersborden en hekkens dienen door de organisatoren volgens het voorstel van de Lokale Politiezone Pajottenland, overeenkomstig de wettelijke voorschriften voor het evenement geplaatst en onmiddellijk na het evenement te worden verwijderd of afgedekt.  
                                         
                                     
                                 
                            """ ;
    prov:wasGeneratedBy <https://pajottegem-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/2b9f5fe1-ffa5-432a-abdf-2704935c273d> .


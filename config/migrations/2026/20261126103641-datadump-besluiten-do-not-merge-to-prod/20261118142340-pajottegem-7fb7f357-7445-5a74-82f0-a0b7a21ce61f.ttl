<https://pajottegem-echo.cipalschaubroeck.be/id/besluiten/5f243214-b148-4b17-8380-5ad85a15e978> a ns2:Besluit,
        <https://data.vlaanderen.be/id/concept/BesluitType/256bd04a-b74b-4f2a-8f5d-14dda4765af9> ;
    ns3:description """ 
                                                    Het college keurt de politieverordening met tijdelijke verkeersmaatregelen voor de tijdelijke parkeerplaatsen op 19/05 t.e.m. 28/05 goed. 
                                                """ ;
    ns3:language <http://publications.europa.eu/resource/authority/language/NLD> ;
    ns3:passed_by <http://data.lblod.info/id/bestuursorganen/1cd382ca-87a9-4693-8216-a4e5e16af3fa> ;
    ns3:title "Politieverordening: Tijdelijke parkeerplaatsen WZC - 19/05 t.e.m. 28/05" ;
    ns2:motivering """ 
                            """@nl ;
    ns1:uuid "7fb7f357-7445-5a74-82f0-a0b7a21ce61f" ;
    prov:value """ 
                                 
                                    
                                        Artikel 1 - Ter gelegenheid van tijdelijke parkeerplaatsen op 19/05 t.e.m. 28/05 worden volgende maatregelen voor het verkeer genomen tussen 6u en 22u:
                                     
                                    
                                         
                                     
                                    
                                        Toegelaten parkeren op verhoogde berm (E9e) mits voorzien doorgang van minimum 1.5 meter voor voetgangers, op strook thv WZC (bushalte vrij laten)
                                     
                                    
                                         
                                     
                                     
                                         
                                            Artikel 2 - De signalisatie zal worden aangeleverd door de gemeentediensten overeenkomstig de wettelijke voorschriften. 
                                         
                                        Artikel 3 - Te voorzien door de aanvragers: 
                                         
                                             De bewoners langsheen de straten waar er verkeersmaatregelen worden ingevoerd, moeten minstens 48 uur op voorhand schriftelijk op de hoogte worden gebracht van de tijdelijke inrichting en van de verkeersmaatregelen.  
                                             Alle tijdelijk voorziene verkeersborden en hekkens dienen door de aanvragers overeenkomstig de wettelijke voorschriften voor de tijdelijke inrichting geplaatst en onmiddellijk na de tijdelijke inrichting te worden verwijderd of afgedekt.  
                                         
                                     
                                 
                            """ ;
    prov:wasGeneratedBy <https://pajottegem-echo.cipalschaubroeck.be/id/behandelingen-van-agendapunten/5f243214-b148-4b17-8380-5ad85a15e978> .

